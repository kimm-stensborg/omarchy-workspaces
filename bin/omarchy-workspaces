#!/bin/bash
# omarchy-workspaces — pin Hyprland workspaces to specific monitors.
#
# Ships inside the plugin folder rather than on PATH, so `omarchy plugin add`
# is the whole install. The overlay and the service both call it by absolute
# path; link it into ~/.local/bin yourself if you want it as a command.
#
# Config:    ~/.config/omarchy/workspaces.json   (source of truth)
# Generated: ~/.config/hypr/workspaces.lua       (never edit by hand)
#
# The same config file is read by the bar widget (io.github.kimm-stensborg.workspaces),
# so the bar and the compositor can never disagree about who owns what.

set -euo pipefail

CONFIG="${OMARCHY_WORKSPACES_CONFIG:-$HOME/.config/omarchy/workspaces.json}"
PLUGIN_ID="io.github.kimm-stensborg.workspaces"
GENERATED="${OMARCHY_WORKSPACES_LUA:-$HOME/.config/hypr/workspaces.lua}"

# Omarchy binds SUPER+1..SUPER+0 and nothing else, so ten is the number of
# workspaces that can be reached from the keyboard at all. That is a fact about
# Omarchy, not a choice this plugin makes — it is why `0` means workspace 10
# everywhere, and the range apply_binds has to sweep when taking keys away.
# How many workspaces you actually *use* is `count` in the config, and is not
# this number; it is read from the config wherever it matters.
KEY_SLOTS=10
MONITORS_LUA="${OMARCHY_MONITORS_LUA:-$HOME/.config/hypr/monitors.lua}"
QUIET=0

die() { echo "omarchy-workspaces: $*" >&2; exit 1; }
say() { ((QUIET)) || echo "$@"; }

# ── config helpers ───────────────────────────────────────────────────────────

ensure_config() {
  [[ -f $CONFIG ]] || die "no config at $CONFIG — run '$0 bootstrap' first"
  jq -e '.version == 1' "$CONFIG" >/dev/null 2>&1 || die "$CONFIG is not a version 1 config"
  migrate_scrollable
  migrate_profiles
}

# There used to be a list of saved layouts, matched against whatever was
# plugged in by taking the first whose monitors were all present. It read as
# flexibility and behaved as a trap: unplug the laptop from a three-monitor
# desk and a single-monitor entry would match first, collapsing all ten
# workspaces onto one screen while the other sat there connected and empty.
#
# The behaviour people expect needs no list at all — a monitor that is not
# there has its workspaces reflow onto the nearest one that is. So there is
# one layout now. The fullest of the old entries is kept, since that is the
# one describing the whole desk; the degenerate single-monitor ones described
# the failure this replaces.
migrate_profiles() {
  jq -e 'has("profiles")' "$CONFIG" >/dev/null 2>&1 || return 0
  jq '
    (.profiles // []) as $old
    | ($old | max_by(.monitors // {} | length) // {}) as $best
    | del(.profiles)
    | .monitors = ($best.monitors // {})
    | (if (($best.disabled // []) | length) > 0 then .disabled = $best.disabled else . end)
    | (if (($best.layouts // {}) | length) > 0 then .layouts = $best.layouts else . end)
  ' "$CONFIG" | write_config
  say "Collapsed the saved layout list into one layout; monitors that go missing now reflow."
}

# Layout used to be settable per monitor as well as per workspace. Two controls
# for one property is one too many now that SUPER+L writes the per-workspace
# one, so the monitor-level setting is gone — but dropping it silently would
# change what a screen is doing. Fold it down instead: every workspace on a
# monitor that was set to scroll gets that as its own override, which is the
# same picture expressed the one remaining way. Runs once; the key is removed
# after, so this is a no-op on every later call.
migrate_scrollable() {
  jq -e 'any((.profiles // [])[]; has("scrollable"))' "$CONFIG" >/dev/null 2>&1 || return 0
  jq '
    .profiles |= map(
      if has("scrollable") then
        . as $p
        | (($p.scrollable // []) | map($p.monitors[.] // []) | add // []) as $ws
        | .layouts = (($ws | map({ (tostring): "scrolling" }) | add // {}) + (.layouts // {}))
        | del(.scrollable)
        | (if (.layouts | length) == 0 then del(.layouts) else . end)
      else . end)' "$CONFIG" | write_config
  say "Folded the per-monitor scroll setting into per-workspace layouts."
}

write_config() { # stdin = new json
  local tmp
  tmp=$(mktemp "${CONFIG}.XXXXXX")
  cat >"$tmp"
  jq -e . "$tmp" >/dev/null || { rm -f "$tmp"; die "refusing to write invalid JSON"; }
  mkdir -p "$(dirname "$CONFIG")"
  mv "$tmp" "$CONFIG"
}

monitors_json() { hyprctl monitors -j; }

# Resolve a config selector ("eDP-1" or "desc:Some Monitor SERIAL") to the
# connected output name, or empty when that monitor is not plugged in.
resolve_selector() {
  local selector=$1
  monitors_json | jq -r --arg sel "$selector" '
    if ($sel | startswith("desc:")) then
      ($sel | ltrimstr("desc:")) as $d
      | [ .[] | select(.description == $d or (.description | startswith($d))) | .name ] | first // ""
    else
      [ .[] | select(.name == $sel) | .name ] | first // ""
    end'
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_detect() {
  [[ -f $CONFIG && ${FORCE:-0} -eq 0 ]] && die "$CONFIG already exists (pass --force to overwrite)"
  local count=${COUNT:-$KEY_SLOTS}
  [[ $count =~ ^[0-9]+$ ]] && ((count > 0)) || die "--count takes a positive number"

  # Spread 1..10 evenly over the connected monitors, left to right, and add a
  # single-monitor fallback profile for every monitor so undocking never
  # strands a workspace.
  monitors_json | jq --argjson c "$count" '
    def selector: if (.description | length) > 0 then "desc:" + .description else .name end;
    ( sort_by(.x) ) as $mons
    | ($mons | length) as $n
    | [ range(0; $n) as $i
        | { key: ($mons[$i] | selector),
            value: [ range(1; $c + 1) | select((. - 1) * $n / $c | floor == $i) ] } ]
      | from_entries as $docked
    | { version: 1, count: $c, persistent: true, monitors: $docked }' | write_config

  say "Wrote $CONFIG from the ${1:-currently} connected monitors."
  cmd_list
}

cmd_list() {
  ensure_config
  echo
  jq -r '
    ((.disabled // []) | map({ key: (. | tostring), value: true }) | from_entries) as $off
    | ((.layouts // {})) as $lay
    | .monitors | to_entries[]
    | "  " + (.key | if startswith("desc:") then ltrimstr("desc:") else . end)
      + "\n      " + ([.value[]
          | (if . == 10 then "0" else tostring end) as $label
          | (if $off[. | tostring] then "(" + $label + ")" else $label end)
            + (if $lay[. | tostring] then ":" + $lay[. | tostring] else "" end)] | join("  "))
      + "\n"' "$CONFIG"
  echo "  (n) is switched off. n:layout is pinned away from the global layout."
  echo
}

cmd_status() {
  ensure_config
  echo "Config:   $CONFIG"
  echo "Lua:      $GENERATED"
  echo
  printf '%-6s %-10s %-10s %s\n' "WS" "HOME" "ACTUAL" ""
  local ws sel home actual
  for ws in $(managed_workspaces); do
    sel=$(selector_of "$ws")
    [[ -z $sel ]] && continue
    if jq -e --argjson w "$ws" '((.disabled // []) | index($w)) != null' "$CONFIG" >/dev/null; then
      printf '%-6s %-10s %-10s %s\n' "$ws" "$(resolve_selector "$sel")" "-" "off"
      continue
    fi
    home=$(resolve_selector "$sel")
    actual=$(hyprctl workspaces -j | jq -r --argjson w "$ws" '.[] | select(.id == $w) | .monitor')
    [[ -z $actual ]] && actual="-"
    # A workspace whose own monitor is unplugged has reflowed somewhere else.
    # That is correct behaviour, not drift, so it is named rather than flagged.
    printf '%-6s %-10s %-10s %s\n' "$ws" "${home:-offline}" "$actual" \
      "$(if [[ -z $home ]]; then echo 'reflowed — its monitor is unplugged'
         elif [[ $actual != "-" && $actual != "$home" ]]; then echo '← misplaced'; fi)"
  done
}

# expand "1-4" / "1,2,3" / "1 2 3" into a JSON array
expand_range() {
  local out=()
  local tok
  for tok in $(tr ',' ' ' <<<"$*"); do
    if [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then
      local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
      ((a <= b)) || die "bad range '$tok'"
      for ((n = a; n <= b; n++)); do out+=("$n"); done
    elif [[ $tok =~ ^[0-9]+$ ]]; then
      out+=("$((tok == 0 ? KEY_SLOTS : tok))")
    else
      die "not a workspace number or range: '$tok'"
    fi
  done
  ((${#out[@]})) || die "no workspaces given"
  printf '%s\n' "${out[@]}" | jq -Rn '[inputs | tonumber] | unique'
}

# Accept a live output name and give back the stable desc: selector for it, so
# nothing stored in the config depends on an output name that can move.
selector_for() {
  local monitor=$1 desc
  desc=$(monitors_json | jq -r --arg m "$monitor" '.[] | select(.name == $m) | .description' || true)
  if [[ -n $desc && $desc != "null" ]]; then echo "desc:$desc"; else echo "$monitor"; fi
}

cmd_assign() {
  ensure_config
  local monitor=${1:?usage: assign <monitor> <workspaces>}; shift
  local wanted; wanted=$(expand_range "$@")
  local selector; selector=$(selector_for "$monitor")

  jq --arg m "$selector" --argjson ws "$wanted" '
    .monitors |= (with_entries(.value -= $ws) | .[$m] = ((.[$m] // []) + $ws | unique)
                  | with_entries(select(.value | length > 0)))' "$CONFIG" | write_config

  say "Assigned $(tr '\n' ' ' <<<"$(jq -r '.[]' <<<"$wanted")")to $monitor."
}

# Workspaces this plugin speaks for in the active profile: everything the
# profile assigns to a monitor, disabled ones included. Used to decide which of
# Omarchy's saved layout overrides are ours to clear.
managed_workspaces() {
  jq -r '[.monitors[][]] | unique | .[]' "$CONFIG"
}

# The selector this layout puts a given workspace on, empty if none does.
selector_of() {
  jq -r --argjson w "$1" \
    '.monitors | to_entries[] | select(.value | index($w)) | .key' "$CONFIG"
}

# Omarchy's SUPER+L toggle saves a per-workspace layout to
# ~/.local/state/omarchy/workspace-layouts/<id>.lua, and `default.hypr.toggles`
# loads that directory after hypr/workspaces.lua — so a stale file outranks the
# rules generated here on every reload, forever. Clearing the ones covering our
# own workspaces at apply time is what makes this plugin's layouts mean
# something. SUPER+L keeps working; its choice just stops outliving an apply.
LAYOUT_STATE="${OMARCHY_WORKSPACE_LAYOUTS:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts}"

clear_layout_overrides() {
  [[ -d $LAYOUT_STATE ]] || return 0
  local ws cleared=0
  while IFS= read -r ws; do
    [[ -f "$LAYOUT_STATE/$ws.lua" ]] || continue
    rm -f "$LAYOUT_STATE/$ws.lua" && cleared=$((cleared + 1))
  done < <(managed_workspaces || true)
  ((cleared)) && say "Cleared $cleared saved SUPER+L layout override(s)."
  return 0
}

# Turn workspaces on or off. A disabled workspace keeps its place on a monitor
# — the editor still draws the pill there — but gets no rule and no keybinding,
# so it cannot be reached or created at all.
cmd_workspace_state() {
  ensure_config
  local wanted_off=$1; shift
  local wanted; wanted=$(expand_range "$@")

  jq --argjson ws "$wanted" --argjson off "$wanted_off" '
    .disabled = (
      if $off then (((.disabled // []) + $ws) | unique)
      else ((.disabled // []) - $ws) end)
    | (if (.disabled | length) == 0 then del(.disabled) else . end)' "$CONFIG" | write_config

  say "$(if [[ $wanted_off == true ]]; then echo Disabled; else echo Enabled; fi)$(tr '\n' ' ' <<<"$(jq -r '" " + (.[]|tostring)' <<<"$wanted")")."
}

GENERATED_MARKER="GENERATED BY omarchy-workspaces"

# True when $GENERATED is absent or carries our banner — i.e. when replacing it
# throws away nothing a human wrote.
generated_by_us() {
  [[ -f $GENERATED ]] || return 0
  head -1 "$GENERATED" | grep -q "$GENERATED_MARKER"
}

cmd_generate() {
  ensure_config
  mkdir -p "$(dirname "$GENERATED")"
  {
    cat <<'LUA'
-- GENERATED BY omarchy-workspaces — DO NOT EDIT.
-- Edit ~/.config/omarchy/workspaces.json instead; the plugin's shell service
-- picks the change up and regenerates this file.
--
-- Pins each workspace to a home monitor. Monitors are matched by description
-- (serial included) so identical displays keep their identity across reboots
-- and dock reconnects. A monitor that is not plugged in has its workspaces
-- reflow onto the nearest one that is, and get them back when it returns.

local monitors = {
LUA
    jq -r '
      .monitors | to_entries | map(
        "  { selector = " + (.key | @json) + ", workspaces = { " +
        (.value | map(tostring) | join(", ")) + " } },") | join("\n")' "$CONFIG"
    cat <<'LUA'
}
LUA
    jq -r '
      "local disabled_list = { " + (((.disabled // []) | map(tostring)) | join(", ")) + " }\n" +
      "local overrides = { " +
      (((.layouts // {}) | to_entries | map("[" + .key + "] = " + (.value | @json))) | join(", ")) +
      " }"' "$CONFIG"
    local persistent self
    persistent=$(jq -r 'if .persistent == false then "false" else "true" end' "$CONFIG")
    self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")
    cat <<LUA

local persistent = $persistent
local key_slots = $KEY_SLOTS
local toggle_cmd = "bash '$self' toggle-layout"
LUA
    cat <<'LUA'

local disabled = {}
for _, ws in ipairs(disabled_list) do disabled[ws] = true end

local function connected()
  local byName, descs = {}, {}
  for _, m in ipairs(hl.get_monitors() or {}) do
    byName[m.name] = m
    descs[#descs + 1] = { desc = m.description or "", monitor = m }
  end
  return byName, descs
end

local function resolve(selector, byName, descs)
  if selector:sub(1, 5) == "desc:" then
    local want = selector:sub(6)
    for _, entry in ipairs(descs) do
      if entry.desc == want or entry.desc:sub(1, #want) == want then return entry.monitor end
    end
    return nil
  end
  return byName[selector]
end

-- Where each workspace actually goes right now.
--
-- The layout says which monitor owns what. A monitor that is not plugged in
-- owns nothing it can hold, so its workspaces reflow onto the nearest monitor
-- that is — nearest by position in the layout, which is written left to right,
-- preferring the neighbour to the left. Nothing is written to disk when this
-- happens: the layout is still the layout, and plugging the monitor back in
-- puts its workspaces home again.
local function placement()
  local byName, descs = connected()
  local live, present = {}, {}
  for i, group in ipairs(monitors) do
    live[i] = resolve(group.selector, byName, descs)
    if live[i] then present[#present + 1] = i end
  end
  if #present == 0 then return nil end

  -- Distance doubled so the +1 only ever breaks a tie, never outranks a
  -- genuinely closer monitor on the right.
  local function nearest(from)
    local best, bestDistance
    for _, i in ipairs(present) do
      local distance = math.abs(i - from) * 2 + (i > from and 1 or 0)
      if not bestDistance or distance < bestDistance then best, bestDistance = i, distance end
    end
    return best
  end

  local out, index = {}, {}
  for _, i in ipairs(present) do
    index[live[i].name] = #out + 1
    out[#out + 1] = { monitor = live[i], workspaces = {} }
  end
  for i, group in ipairs(monitors) do
    local target = live[i] and i or nearest(i)
    local slot = out[index[live[target].name]]
    for _, ws in ipairs(group.workspaces) do
      if not disabled[ws] then slot.workspaces[#slot.workspaces + 1] = ws end
    end
  end
  for _, slot in ipairs(out) do table.sort(slot.workspaces) end
  return out
end

local groups = placement()

-- What a workspace gets with no override of its own: whatever you have set
-- globally, except when that is itself `scrolling` — a workspace toggled off
-- scrolling has to land on tiling, and then there is no global tiling layout
-- left to fall back to.
local function tiling_layout()
  local global = hl.get_config("general.layout")
  if type(global) ~= "string" or global == "" or global == "scrolling" then return "dwindle" end
  return global
end

-- Every rule names a layout, including the non-scrolling ones. Leaving `layout`
-- off does not restore the default: a reload with no layout in the rule leaves
-- a workspace sitting in whatever layout it last had, so toggling scrolling
-- back off would be a change you could not undo without a restart.
--
-- A disabled workspace gets no rule at all. Nothing pins it, nothing makes it
-- persistent, so it never appears on a bar or in the workspace list; its keys
-- are unbound further down.
-- Layout is per workspace and nothing else. SUPER+L writes these overrides;
-- anything without one follows the global layout.
local function layout_for(ws, tiling)
  local own = overrides[ws]
  if type(own) == "string" and own ~= "" then return own end
  return tiling
end

local function apply_rules()
  if not groups then return end
  local tiling = tiling_layout()
  for _, group in ipairs(groups) do
    for _, ws in ipairs(group.workspaces) do
      if not disabled[ws] then
        hl.workspace_rule({
          workspace = tostring(ws),
          monitor = group.monitor.name,
          layout = layout_for(ws, tiling),
          default = true,
          persistent = persistent,
        })
      end
    end
  end
end

apply_rules()

-- Rules only bind a workspace at creation time, so anything that already
-- exists (or drifted after a hotplug) is walked home once the config settles.
local function rehome()
  local current = placement()
  if not current then return end
  for _, group in ipairs(current) do
    for _, ws in ipairs(group.workspaces) do
      if not disabled[ws] then
        local workspace = hl.get_workspace(tostring(ws))
        if workspace and workspace.monitor and workspace.monitor.name ~= group.monitor.name then
          hl.dispatch(hl.dsp.workspace.move({ workspace = tostring(ws), monitor = group.monitor.name }))
        end
      end
    end
  end
end

-- A disabled workspace has to be unreachable, not merely unpinned: with the
-- key still bound, SUPER+4 would create workspace 4 on whatever monitor is
-- focused, which is the placement this plugin exists to prevent. Only the
-- unbind is needed — a reload re-runs Omarchy's bindings and restores every
-- key, so this pass just takes the disabled ones back out again afterwards.
-- Which workspaces the layout actually speaks for. A key slot that
-- is not in here belongs to nobody: either it is switched off, or the config
-- has fewer workspaces than Omarchy has keys. Both want the same treatment,
-- because a bound key with no rule behind it opens a workspace on whatever
-- monitor happens to be focused — the placement this plugin exists to prevent.
local function managed()
  local set = {}
  if groups then
    for _, group in ipairs(groups) do
      for _, ws in ipairs(group.workspaces) do set[ws] = true end
    end
  end
  return set
end

local function apply_binds()
  local mine = managed()
  for ws = 1, key_slots do
    if disabled[ws] or not mine[ws] then
      local code = "code:" .. tostring(ws + 9)
      hl.unbind("SUPER + " .. code)
      hl.unbind("SUPER + SHIFT + " .. code)
      hl.unbind("SUPER + SHIFT + ALT + " .. code)
    end
  end

  -- Omarchy binds SUPER+L to its own layout toggle, which saves the result to
  -- ~/.local/state/omarchy/workspace-layouts and is loaded after this file --
  -- so left alone it would keep writing a second, competing answer that wins
  -- on every reload. Point the same key at the same job done against this
  -- plugin's config instead. The key still toggles the active workspace
  -- between tiling and scrolling; only the place it records that changes.
  hl.unbind("SUPER + L")
  hl.bind("SUPER + L", hl.dsp.exec_cmd(toggle_cmd), { description = "Toggle workspace layout" })
end

-- Omarchy's own SUPER+L layout toggle persists its choice to
-- ~/.local/state/omarchy/workspace-layouts/<id>.lua, and `default.hypr.toggles`
-- requires that directory *after* this file, so on every reload those saved
-- overrides land on top of the rules above and silently win. Re-asserting once
-- the config has settled puts this plugin's answer last, which is what makes
-- the layout overrides stick. SUPER+L still works live; it just no longer
-- outlives the next apply.
local function settle()
  apply_rules()
  apply_binds()
  rehome()
end

hl.timer(settle, { timeout = 500, type = "oneshot" })

-- A monitor coming or going changes where everything reflows to, so the rules
-- are rebuilt in place. No reload: the layout on disk has not changed, only
-- which monitors are answering, and re-deriving is both faster and free of the
-- loop risk a reload carries. The hooked flag keeps `hyprctl reload` from
-- stacking a second copy of these subscriptions.
_G.__omarchy_workspaces = _G.__omarchy_workspaces or {}
local state = _G.__omarchy_workspaces

local function on_monitor_change()
  hl.timer(function()
    groups = placement()
    settle()
  end, { timeout = 400, type = "oneshot" })
end

if not state.hooked then
  state.hooked = true
  hl.on("monitor.added", on_monitor_change)
  hl.on("monitor.removed", on_monitor_change)
end
LUA
  } >"$GENERATED"
  say "Generated $GENERATED"
}

ensure_required() {
  local main="$HOME/.config/hypr/hyprland.lua"
  [[ -f $main ]] || die "missing $main"
  grep -q 'hypr.workspaces' "$main" && return 1
  cat >>"$main" <<'LUA'

-- Workspace-to-monitor pinning. Generated by omarchy-workspaces; the require is
-- optional so a missing/renamed workspaces.lua can never break the whole config.
require("default.hypr.require_optional").module("hypr.workspaces")
LUA
  say "Hooked workspaces.lua into hyprland.lua"
  return 0
}

# Walk any workspace that is not on its home monitor back onto it. Workspace
# rules only bind at creation time, so anything already open when the rules
# change has to be moved by hand.
rehome_workspaces() {
  local ws sel home actual
  for ws in $(managed_workspaces); do
    sel=$(selector_of "$ws")
    [[ -z $sel ]] && continue
    home=$(resolve_selector "$sel")
    # Unplugged: the generated Lua has already reflowed it somewhere sensible,
    # and second-guessing that from here would only fight it.
    [[ -z $home ]] && continue
    actual=$(hyprctl workspaces -j | jq -r --argjson w "$ws" '.[] | select(.id == $w) | .monitor')
    [[ -n $actual && $actual != "$home" ]] &&
      hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$ws\", monitor = \"$home\" })" >/dev/null
  done
  # The loop's last statement is a test that is false whenever nothing needed
  # moving, which under `set -e` would take the caller down with it.
  return 0
}

reload_hyprland() {
  hyprctl reload >/dev/null
  local errors
  errors=$(hyprctl configerrors)
  if [[ $errors != "no errors" && -n $errors ]]; then
    echo "$errors" >&2
    die "Hyprland reported config errors (see above)"
  fi
}

cmd_apply() {
  cmd_generate
  ensure_required || true
  clear_layout_overrides
  reload_hyprland
  # Nudge already-open workspaces onto their home monitor right away rather
  # than waiting for the lua timer.
  rehome_workspaces
  # Deliberately no `rescanPlugins` here. That reloads plugin *code*, and doing
  # it during a config change races the bar's in-place settings patch: the patch
  # lands on the bar's layout copy but not on the widget being torn down, and
  # because the next reload then sees no delta, nothing ever reconciles it. The
  # widget watches workspaces.json itself, so there is nothing to nudge.

  # Claiming success was the habit that let every previous bug hide. Ask before
  # saying it: the rules are in, but something else on this machine may have
  # had the last word. The settle timer in the generated Lua has to land first.
  sleep 1
  local report
  if report=$(QUIET=1 cmd_doctor 2>&1); then
    say "Applied."
  else
    echo "omarchy-workspaces: applied, but the result does not match:" >&2
    grep '✗' <<<"$report" >&2
    echo "  (run 'omarchy-workspaces doctor' for the full picture)" >&2
    return 1
  fi
}

# What the shell service runs at startup and whenever workspaces.json changes.
# `omarchy plugin add` never runs an install hook, so enabling the plugin has to
# be the whole setup: seed a config from the connected monitors on a first run,
# keep workspaces.lua in step with the config, and hook it into hyprland.lua.
#
# Idempotent by construction — it reloads Hyprland only when the generated Lua
# actually came out different, so the every-shell-start case costs one diff and
# touches nothing.
cmd_bootstrap() {
  local changed=0

  # Someone may already pin workspaces by hand — that is a perfectly good way to
  # do this, and it is the file this plugin wants to own. Unattended is the
  # wrong moment to overwrite it, so bootstrap stops and says so; `apply` is
  # where the user has actually asked for the replacement.
  if ! generated_by_us; then
    echo "omarchy-workspaces: $GENERATED was not generated by this plugin — leaving it alone." >&2
    echo "omarchy-workspaces: run 'omarchy-workspaces apply' to replace it with generated rules." >&2
    return 0
  fi

  if [[ ! -f $CONFIG ]]; then
    FORCE=1 QUIET=1 cmd_detect >/dev/null
    say "Seeded $CONFIG from the connected monitors."
    changed=1
  fi

  local before=""
  [[ -f $GENERATED ]] && before=$(cat "$GENERATED")
  QUIET=1 cmd_generate
  [[ $before == "$(cat "$GENERATED")" ]] || changed=1

  ensure_required && changed=1

  if ((changed)); then
    reload_hyprland
    rehome_workspaces
    say "Bootstrapped: workspace rules are in sync."
  else
    say "Already in sync."
  fi
}

# ── per-workspace layout ─────────────────────────────────────────────────────

# What a workspace shows with no override: the global layout, or dwindle when
# that is itself scrolling, since "not scrolling" has to mean something.
default_layout() {
  local global
  global=$(hyprctl getoption general:layout -j 2>/dev/null | jq -r '.str // ""')
  [[ -z $global || $global == "scrolling" ]] && echo dwindle || echo "$global"
}

effective_layout() {
  local own
  own=$(jq -r --arg w "$1" '.layouts[$w] // ""' "$CONFIG")
  [[ -n $own ]] && echo "$own" || default_layout
}

# Pin one workspace to a layout, or hand it back to the global one.
cmd_layout() {
  ensure_config
  local ws=${1:?usage: layout <workspace> <scrolling|dwindle|default>}
  local want=${2:?usage: layout <workspace> <scrolling|dwindle|default>}
  [[ $ws =~ ^[0-9]+$ ]] || die "not a workspace number: '$ws'"
  ((ws == 0)) && ws=$KEY_SLOTS

  case $want in
    default|auto|clear)
      jq --arg w "$ws" '
        .layouts = ((.layouts // {}) | del(.[$w]))
        | (if (.layouts | length) == 0 then del(.layouts) else . end)' "$CONFIG" | write_config
      say "Workspace $ws follows the global layout again." ;;
    scrolling|dwindle|master)
      jq --arg w "$ws" --arg v "$want" '
        .layouts = ((.layouts // {}) + { ($w): $v })' "$CONFIG" | write_config
      say "Workspace $ws pinned to $want." ;;
    *) die "layout takes scrolling, dwindle, or default" ;;
  esac
}

# What SUPER+L runs. Omarchy's own toggle saves to a state directory this
# plugin cannot see into without a fight; this does the same job against the
# one config that is already the source of truth, so the two stop disagreeing.
#
# It runs on a keypress, so it stays off the slow paths: no `apply`, no
# `hyprctl reload`. The rule goes in live, and the generated Lua is rewritten
# to match *before* the config is saved, so the service's watcher finds nothing
# to reconcile and does not bounce the compositor a second later.
cmd_toggle_layout() {
  ensure_config
  local ws current next
  ws=$(hyprctl activeworkspace -j | jq -r '.id')
  [[ $ws =~ ^[0-9]+$ ]] || die "no active workspace"

  current=$(effective_layout "$ws")
  [[ $current == scrolling ]] && next=dwindle || next=scrolling

  # An override equal to the global layout is noise in the config, so a toggle
  # back to the default clears the entry rather than restating it.
  if [[ $next == "$(default_layout)" ]]; then
    QUIET=1 cmd_layout "$ws" default
  else
    QUIET=1 cmd_layout "$ws" "$next"
  fi

  QUIET=1 cmd_generate
  hyprctl eval "hl.workspace_rule({ workspace = \"$ws\", layout = \"$next\" })" >/dev/null 2>&1

  omarchy-cmd-present omarchy-notification-send &&
    omarchy-notification-send -g 󱂬 "Workspace $ws layout set to $next" >/dev/null 2>&1
  say "Workspace $ws is now $next."
}

# ── doctor ───────────────────────────────────────────────────────────────────
#
# Compare what the config asks for against what Hyprland is actually doing.
#
# Everything this plugin writes lands in files it does not own, next to other
# things that write to the same places — Omarchy's SUPER+L layout toggle, a
# hand-edited monitors.lua, whatever put a workspace somewhere at login. When
# one of those wins, nothing announces it: `apply` reloads, prints "Applied",
# and the disagreement sits there until someone notices the screen is not doing
# what the config says. Every bug this plugin has had was that shape.
#
# So: ask, do not assume. Exit 1 on any drift so `apply` can refuse to claim
# success and a keybinding or hook can notice too.

# The layout a non-scrolling monitor should be showing. Mirrors tiling_layout()
# in the generated Lua — keep the two in step.
expected_tiling() {
  local global
  global=$(hyprctl getoption general:layout -j 2>/dev/null | jq -r '.str // ""')
  if [[ -z $global || $global == "scrolling" ]]; then echo "dwindle"; else echo "$global"; fi
}

DOCTOR_PROBLEMS=0
ok()    { say "  ✓ $*"; }
bad()   { echo "  ✗ $*" >&2; DOCTOR_PROBLEMS=$((DOCTOR_PROBLEMS + 1)); }

cmd_doctor() {
  ensure_config
  DOCTOR_PROBLEMS=0
  say "Config:   $CONFIG"
  say ""

  # ── the generated file still says what we would generate now ──────────────
  if ! generated_by_us; then
    bad "$GENERATED was not generated by this plugin — 'apply' would replace it"
  else
    local tmp live; tmp=$(mktemp); live="$GENERATED"
    GENERATED="$tmp" QUIET=1 cmd_generate
    # The generated file embeds the absolute path of whichever copy of this
    # script wrote it, so a repo checkout and the installed plugin produce
    # files that differ on that line and nothing else. Comparing it would
    # report "stale" whenever the two are not the same copy, which is a false
    # alarm, and a check that cries wolf is worse than no check. The path is
    # verified on its own terms just below instead.
    if diff -q <(grep -v '^local toggle_cmd = ' "$tmp") \
               <(grep -v '^local toggle_cmd = ' "$live") >/dev/null 2>&1; then
      ok "workspaces.lua matches the config"
    else
      bad "workspaces.lua is stale — the config changed since the last apply"
    fi
    rm -f "$tmp"

    # What that line points at has to exist, or SUPER+L does nothing.
    local bound_to
    bound_to=$(sed -n "s/^local toggle_cmd = \"bash '\(.*\)' toggle-layout\"$/\1/p" "$live")
    if [[ -z $bound_to ]]; then
      bad "workspaces.lua has no SUPER+L command in it"
    elif [[ ! -r $bound_to ]]; then
      bad "SUPER+L points at $bound_to, which is not there"
    else
      ok "SUPER+L points at a script that exists"
    fi
  fi

  grep -q 'hypr.workspaces' "$HOME/.config/hypr/hyprland.lua" 2>/dev/null \
    && ok "hyprland.lua requires hypr.workspaces" \
    || bad "hyprland.lua does not require hypr.workspaces — no rule is being applied"

  # ── the layout itself, before anything is compared to a screen ───────────
  local faults
  faults=$(jq -r '
    ([.monitors[][]]) as $all
    | (
        # A workspace on two monitors at once has no home, which is the one
        # thing this plugin promises.
        ( $all | group_by(.) | map(select(length > 1) | .[0]) | sort
          | if length > 0 then
              [ "workspace " + (map(tostring) | join(", ")) + " is on two monitors" ]
            else [] end )
        # Switching off, or pinning the layout of, a workspace the layout never
        # places is a line that will never do anything.
        + ( ((.disabled // []) - ($all | unique)) | sort
            | if length > 0 then
                [ "disabled workspace " + (map(tostring) | join(", ")) + " is not in the layout" ]
              else [] end )
        + ( (((.layouts // {}) | keys | map(tonumber)) - ($all | unique)) | sort
            | if length > 0 then
                [ "layout pinned for workspace " + (map(tostring) | join(", ")) + ", which is not in the layout" ]
              else [] end )
        + ( if ((.monitors // {}) | length) == 0 then [ "the layout places no workspaces at all" ] else [] end )
      ) | .[]' "$CONFIG")

  if [[ -n $faults ]]; then
    while IFS= read -r line; do [[ -n $line ]] && bad "$line"; done <<<"$faults"
  else
    ok "the layout is self-consistent"
  fi

  # Everything above holds whatever is plugged in. Everything below compares
  # against a running compositor, which needs at least one monitor answering.
  if [[ $(monitors_json | jq 'length') == 0 ]]; then
    bad "no monitors are connected"
    say ""
    echo "$DOCTOR_PROBLEMS problem(s)." >&2
    return 1
  fi

  # ── Omarchy's SUPER+L overrides outrank us, so any survivor is a problem ──
  local stale=() ws
  while IFS= read -r ws; do
    [[ -f "$LAYOUT_STATE/$ws.lua" ]] && stale+=("$ws")
  done < <(managed_workspaces || true)
  if ((${#stale[@]})); then
    bad "saved SUPER+L layout override(s) outrank this plugin: workspace ${stale[*]}"
  else
    ok "no competing SUPER+L layout overrides"
  fi

  if hyprctl binds -j | jq -e '[.[] | select(.description == "Toggle workspace layout")] | length == 1' >/dev/null; then
    ok "SUPER+L is bound to this plugin's layout toggle"
  else
    bad "SUPER+L is not bound to this plugin — Omarchy's toggle will write a competing answer"
  fi

  # ── live state, gathered once ─────────────────────────────────────────────
  local live_place live_layout live_binds tiling
  live_place=$(hyprctl workspaces -j | jq -r '[.[] | select(.id > 0) | "\(.id)=\(.monitor)"] | join(" ")')
  live_layout=$(hyprctl repl "local o = {} for i = 1, $KEY_SLOTS do local w = hl.get_workspace(tostring(i))
    o[#o+1] = i .. \"=\" .. (w and tostring(w.tiled_layout) or \"gone\") end return table.concat(o, \" \")" 2>/dev/null)
  live_binds=$(hyprctl binds -j | jq -r '[.[] | select(.description | test("^Switch to workspace "))
    | (.description | sub("^Switch to workspace ";""))] | join(" ")')
  tiling=$(expected_tiling)

  local misplaced=() wronglayout=() stillbound=() unbound=() pinned=0 off=0
  for ws in $(managed_workspaces); do
    local sel; sel=$(selector_of "$ws")
    [[ -z $sel ]] && continue

    local is_off="false"
    jq -e --argjson w "$ws" '((.disabled // []) | index($w)) != null' "$CONFIG" >/dev/null && is_off="true"

    local bound="false"
    [[ " $live_binds " == *" $ws "* ]] && bound="true"

    if [[ $is_off == true ]]; then
      off=$((off + 1))
      [[ $bound == true ]] && stillbound+=("$ws")
      [[ " $live_layout " == *" $ws=gone "* ]] || misplaced+=("$ws exists but is switched off")
      continue
    fi

    pinned=$((pinned + 1))
    [[ $bound == false ]] && unbound+=("$ws")

    local home actual
    home=$(resolve_selector "$sel")
    # Its monitor is unplugged, so it has reflowed elsewhere. Intended.
    [[ -z $home ]] && continue
    actual=$(sed -n "s/.*\b$ws=\([^ ]*\).*/\1/p" <<<"$live_place")
    [[ -n $actual && $actual != "$home" ]] && misplaced+=("$ws on $actual, home is $home")

    local want own
    own=$(jq -r --arg w "$ws" '.layouts[$w] // ""' "$CONFIG")
    [[ -n $own ]] && want="$own" || want="$tiling"
    local got; got=$(sed -n "s/.*\b$ws=\([^ ]*\).*/\1/p" <<<"$live_layout")
    [[ -n $got && $got != "gone" && $got != "$want" ]] && wronglayout+=("$ws is $got, want $want")
  done

  ((${#misplaced[@]})) && bad "placement: ${misplaced[*]}" || ok "placement: all $pinned workspaces on their home monitor"
  ((${#wronglayout[@]})) && bad "layout: ${wronglayout[*]}" || ok "layout: every workspace matches the config"
  ((${#stillbound[@]})) && bad "keys: workspace ${stillbound[*]} switched off but still bound"
  ((${#unbound[@]})) && bad "keys: workspace ${unbound[*]} enabled but has no keybinding"
  ((${#stillbound[@]} + ${#unbound[@]})) || ok "keys: $pinned bound, $off unbound"

  say ""
  if ((DOCTOR_PROBLEMS)); then
    echo "$DOCTOR_PROBLEMS problem(s). Run 'omarchy-workspaces apply' to reconcile." >&2
    return 1
  fi
  say "Everything matches."
  return 0
}

cmd_edit() {
  ensure_config
  omarchy-launch-config-editor "$CONFIG"
}


# Replace a whole profile in one shot. This is what the overlay calls when you
# hit Apply: it hands over the entire monitor -> workspaces map rather than a
# stream of per-monitor edits, so a half-applied layout is not possible.
#
# Keys are live output names; they are stored as desc: selectors, because the
# overlay speaks in the names Hyprland is using right now and the config has to
# survive those names changing.
cmd_set_layout() {
  ensure_config
  local payload="" offs=""
  while (($#)); do
    case $1 in
      --base64)  payload=$(base64 -d <<<"${2:?--base64 needs a value}"); shift 2 ;;
      --disabled-base64)
                 offs=$(base64 -d <<<"${2:?--disabled-base64 needs a value}"); shift 2 ;;
      *)         payload=$1; shift ;;
    esac
  done
  [[ -n $payload ]] || die "set-layout needs a JSON object of monitor -> workspaces"
  jq -e 'type == "object"' <<<"$payload" >/dev/null 2>&1 || die "set-layout payload is not a JSON object"

  local monitors mapped
  monitors=$(monitors_json)
  mapped=$(jq -n --argjson layout "$payload" --argjson mons "$monitors" '
    ( $mons
      | map(select((.description // "") != "") | { key: .name, value: ("desc:" + .description) })
      | from_entries ) as $selector
    | $layout
    | with_entries(
        .key = ($selector[.key] // .key)
        | .value |= (map(tonumber) | unique))
    | with_entries(select(.value | length > 0))')

  # Only the monitors the editor can see are replaced. One that is unplugged
  # is not absent from the desk, only from this screen, and dropping its
  # workspaces because they were not in a payload that could never have
  # mentioned them would lose the layout every time you edited while undocked.
  jq --argjson m "$mapped" '
    ($m | keys) as $touched
    | .monitors = (
        (.monitors | with_entries(select(.key as $k | ($touched | index($k)) == null)))
        + $m)
    | .monitors |= with_entries(.value |= (map(select(. != null)) | unique))' "$CONFIG" | write_config

  if [[ -n $offs ]]; then
    jq -e 'type == "array"' <<<"$offs" >/dev/null 2>&1 ||
      die "--disabled-base64 payload is not a JSON array"
    jq --argjson d "$offs" '
      if ($d | length) == 0 then del(.disabled) else .disabled = ($d | map(tonumber) | unique) end' \
      "$CONFIG" | write_config
  fi

  say "Replaced the layout."
}

arrange_awk() {
  cat <<'AWK'
function value(line, key,    span) {
  if (!match(line, key "[ \t]*=[ \t]*\"[^\"]*\"")) return ""
  span = substr(line, RSTART, RLENGTH)
  match(span, /"[^"]*"/)
  return substr(span, RSTART + 1, RLENGTH - 2)
}

# The block's output, matched against the monitors we were asked to move.
function target_for(out,   i, desc) {
  if (out == "") return 0
  for (i = 1; i <= n; i++) {
    desc = tdesc[i]
    if (out == tname[i]) return i
    if (desc != "" && out == "desc:" desc) return i
    if (substr(out, 1, 5) == "desc:" && desc != "" && index(desc, substr(out, 6)) == 1) return i
  }
  return 0
}

function flush(   i, out, outline, posline, idx, indent) {
  outline = 0; posline = 0; out = ""
  for (i = 1; i <= nb; i++) {
    if (!outline && match(buf[i], /output[ \t]*=[ \t]*"[^"]*"/)) {
      outline = i
      out = value(buf[i], "output")
    }
    if (!posline && match(buf[i], /position[ \t]*=[ \t]*"[^"]*"/)) posline = i
  }

  idx = outline ? target_for(out) : 0
  if (idx > 0) {
    tused[idx] = 1
    if (posline) {
      sub(/position[ \t]*=[ \t]*"[^"]*"/, "position = \"" tpos[idx] "\"", buf[posline])
    } else {
      # No position of its own — give it one, indented like the output line.
      indent = buf[outline]
      sub(/[^ \t].*$/, "", indent)
      for (i = nb; i > outline; i--) buf[i + 1] = buf[i]
      buf[outline + 1] = indent "position = \"" tpos[idx] "\","
      nb++
    }
  }

  for (i = 1; i <= nb; i++) print buf[i]
}

BEGIN {
  while ((getline line < targets) > 0) {
    split(line, field, "\t")
    n++
    tname[n] = field[1]; tdesc[n] = field[2]; tpos[n] = field[3]
  }
  close(targets)
}

{
  if (!inblock) {
    if ($0 !~ /hl\.monitor[ \t]*\(/) { print; next }
    inblock = 1; depth = 0; nb = 0
  }

  buf[++nb] = $0
  # Brace depth, not paren depth: a monitor description can hold a paren, and
  # none of them hold a brace.
  copy = $0; opens = gsub(/\{/, "{", copy)
  copy = $0; closes = gsub(/\}/, "}", copy)
  depth += opens - closes
  if (depth <= 0) { flush(); inblock = 0 }
}

END {
  # An unterminated block is a file we do not understand; hand it back whole.
  if (inblock) for (i = 1; i <= nb; i++) print buf[i]

  for (i = 1; i <= n; i++) {
    if (tused[i]) continue
    if (!appended) {
      print ""
      print "-- " marker " — set the mode and scale you want."
      appended = 1
    }
    printf "hl.monitor({ output = \"%s\", mode = \"preferred\", position = \"%s\", scale = 1 })\n",
      (tdesc[i] != "" ? "desc:" tdesc[i] : tname[i]), tpos[i]
  }
}
AWK
}

cmd_arrange() {
  local payload="" pairs=()
  while (($#)); do
    case $1 in
      --base64) payload=$(base64 -d <<<"${2:?--base64 needs a value}"); shift 2 ;;
      *)        pairs+=("$1"); shift ;;
    esac
  done

  if [[ -z $payload ]]; then
    ((${#pairs[@]} >= 2 && ${#pairs[@]} % 2 == 0)) ||
      die "usage: arrange <monitor> <XxY> [<monitor> <XxY> ...]"
    payload=$(printf '%s\n' "${pairs[@]}" | jq -Rn '
      [inputs] as $f | reduce range(0; $f | length; 2) as $i ({}; .[$f[$i]] = $f[$i + 1])')
  fi

  jq -e 'type == "object" and (length > 0)' <<<"$payload" >/dev/null 2>&1 ||
    die "arrange needs a JSON object of monitor -> \"XxY\""
  jq -e 'all(.[]; type == "string" and test("^-?[0-9]+x-?[0-9]+$"))' <<<"$payload" >/dev/null 2>&1 ||
    die "every position must look like 2560x0"

  # Output name, description, position — one line per monitor, for awk. Only
  # connected monitors: a position for something unplugged has nothing to match
  # and would append a block for a display that may never come back.
  local targets; targets=$(mktemp)
  # shellcheck disable=SC2064
  trap "rm -f '$targets'" RETURN
  jq -r --argjson mons "$(monitors_json)" '
    ($mons | map({ key: .name, value: (.description // "") }) | from_entries) as $desc
    | to_entries[]
    | select($desc[.key] != null)
    | [.key, $desc[.key], .value] | @tsv' <<<"$payload" >"$targets"
  [[ -s $targets ]] || die "none of those monitors are connected"

  if [[ ! -f $MONITORS_LUA ]]; then
    mkdir -p "$(dirname "$MONITORS_LUA")"
    printf -- '-- See https://wiki.hypr.land/Configuring/Basics/Monitors/\n' >"$MONITORS_LUA"
    say "Created $MONITORS_LUA"
  fi

  # monitors.lua is a hand-written file this plugin only visits. Keep the
  # pristine copy the first time we touch it, and never overwrite that backup.
  [[ -f ${MONITORS_LUA}.bak ]] || cp "$MONITORS_LUA" "${MONITORS_LUA}.bak"

  local tmp; tmp=$(mktemp "${MONITORS_LUA}.XXXXXX")
  awk -v targets="$targets" -v marker="$MONITORS_MARKER" -f <(arrange_awk) "$MONITORS_LUA" >"$tmp" ||
    { rm -f "$tmp"; die "could not rewrite $MONITORS_LUA"; }

  if cmp -s "$tmp" "$MONITORS_LUA"; then
    rm -f "$tmp"
    say "Monitor arrangement already matches $MONITORS_LUA."
    return 0
  fi

  chmod --reference="$MONITORS_LUA" "$tmp" 2>/dev/null || true
  mv "$tmp" "$MONITORS_LUA"
  say "Arranged $(wc -l <"$targets") monitors in $MONITORS_LUA."
}

cmd_open() {
  omarchy-shell shell summon "$PLUGIN_ID" '{}' >/dev/null 2>&1 ||
    die "could not summon the overlay (is omarchy-shell running?)"
}

usage() {
  cat <<'USAGE'
omarchy-workspaces — pin Hyprland workspaces to specific monitors

  open                             Open the visual editor overlay
  bootstrap                        Seed config + rules if missing, sync if not
  detect [--force] [--count=N]     Build a config from the connected monitors
  list                             Show the layout
  status                           Show where each workspace lives right now
  doctor                           Check the live state against the config
  assign <mon> <ws>                Assign workspaces (1-4, 1,2,5) to a monitor
  disable <ws>                     Switch workspaces off: no rule, no keybinding
  enable <ws>                      Switch them back on
  generate                         Write ~/.config/hypr/workspaces.lua
  apply                            Generate, reload Hyprland, re-home workspaces
  edit                             Open the config in your editor
  layout <ws> <scrolling|dwindle|default>
                                   Pin one workspace's layout, or clear it
  toggle-layout                    Flip the active workspace (bound to SUPER+L)
  arrange <mon> <XxY> [...]        Move monitors on the desk (rewrites monitors.lua)
  set-layout --base64 <b64>        Replace a whole profile (used by the overlay)

Config: ~/.config/omarchy/workspaces.json
Plugin: ~/.config/omarchy/plugins/io.github.kimm-stensborg.workspaces
USAGE
}

main() {
  local args=()
  for a in "$@"; do
    case $a in
      --quiet) QUIET=1 ;;
      --force) FORCE=1 ;;
      --count=*) COUNT=${a#*=} ;;
      *) args+=("$a") ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  case ${1:-status} in
    bootstrap) cmd_bootstrap ;;
    detect)   shift; cmd_detect "$@" ;;
    list)     cmd_list ;;
    status)   cmd_status ;;
    doctor)   cmd_doctor ;;
    assign|set) shift; cmd_assign "$@" ;;
    disable)  shift; cmd_workspace_state true "$@" ;;
    enable)   shift; cmd_workspace_state false "$@" ;;
    generate) cmd_generate ;;
    apply)    cmd_apply ;;
    edit)     cmd_edit ;;
    open)     cmd_open ;;
    layout)   shift; cmd_layout "$@" ;;
    toggle-layout) cmd_toggle_layout ;;
    arrange|set-monitors) shift; cmd_arrange "$@" ;;
    set-layout) shift; cmd_set_layout "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
