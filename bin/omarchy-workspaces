#!/bin/bash
# omarchy-workspaces — pin Hyprland workspaces to specific monitors.
#
# Ships inside the plugin folder rather than on PATH, so `omarchy plugin add`
# is the whole install. The overlay and the service both call it by absolute
# path; link it into ~/.local/bin yourself if you want it as a command.
#
# Config:    ~/.config/omarchy/workspaces.json   (source of truth)
# Generated: ~/.config/hypr/workspaces.lua       (never edit by hand)
#
# The same config file is read by the bar widget (io.github.kimm-stensborg.workspaces),
# so the bar and the compositor can never disagree about who owns what.

set -euo pipefail

CONFIG="${OMARCHY_WORKSPACES_CONFIG:-$HOME/.config/omarchy/workspaces.json}"
PLUGIN_ID="io.github.kimm-stensborg.workspaces"
GENERATED="${OMARCHY_WORKSPACES_LUA:-$HOME/.config/hypr/workspaces.lua}"

# Omarchy binds SUPER+1..SUPER+0 and nothing else, so ten is the number of
# workspaces that can be reached from the keyboard at all. That is a fact about
# Omarchy, not a choice this plugin makes — it is why `0` means workspace 10
# everywhere, and the range apply_binds has to sweep when taking keys away.
# How many workspaces you actually *use* is `count` in the config, and is not
# this number; it is read from the config wherever it matters.
KEY_SLOTS=10
QUIET=0

# The overview's shortcut goes in your bindings.lua, once, where Plugin Manager
# can see it and you can move it; see bind-overview.
BINDINGS="${OMARCHY_WORKSPACES_BINDINGS:-$HOME/.config/hypr/bindings.lua}"
STATE_DIR="${OMARCHY_WORKSPACES_STATE:-$HOME/.local/state/omarchy-workspaces}"

# The key left of 1, named by position rather than by keysym: it is ` on a US
# layout and ½ on a Danish one, and a keysym would move with the layout. The
# workspace keys are bound the same way (1 is code:10).
OVERVIEW_KEY="SUPER + code:49"
OVERVIEW_PAYLOAD='{"view":"overview"}'

# With --notify nobody reads stderr, so the failure goes up as a notification.
die() {
  echo "omarchy-workspaces: $*" >&2
  if ((${NOTIFY:-0})); then notify -u normal "Workspaces" "$*"; fi
  exit 1
}
say() { ((QUIET)) || echo "$@"; }

# ── config helpers ───────────────────────────────────────────────────────────

ensure_config() {
  [[ -f $CONFIG ]] || die "no config at $CONFIG — run '$0 bootstrap' first"
  jq -e '.version == 1' "$CONFIG" >/dev/null 2>&1 || die "$CONFIG is not a version 1 config"
  migrate_layouts
  migrate_profiles
}

# There used to be a list of saved layouts, matched against whatever was
# plugged in by taking the first whose monitors were all present. It read as
# flexibility and behaved as a trap: unplug the laptop from a three-monitor
# desk and a single-monitor entry would match first, collapsing all ten
# workspaces onto one screen while the other sat there connected and empty.
#
# The behaviour people expect needs no list at all — a monitor that is not
# there has its workspaces reflow onto the nearest one that is. So there is
# one layout now. The fullest of the old entries is kept, since that is the
# one describing the whole desk; the degenerate single-monitor ones described
# the failure this replaces.
migrate_profiles() {
  jq -e 'has("profiles")' "$CONFIG" >/dev/null 2>&1 || return 0
  jq '
    (.profiles // []) as $old
    | ($old | max_by(.monitors // {} | length) // {}) as $best
    | del(.profiles)
    | .monitors = ($best.monitors // {})
    | (if (($best.disabled // []) | length) > 0 then .disabled = $best.disabled else . end)
  ' "$CONFIG" | write_config
  say "Collapsed the saved layout list into one layout; monitors that go missing now reflow."
}

# Which layout a workspace tiles with is Omarchy's business: SUPER+L toggles
# it and saves the result under ~/.local/state/omarchy/workspace-layouts. This
# plugin used to own that too, first per monitor and then per workspace, which
# meant two things writing the same property and a long argument about whose
# answer survived a reload. It places workspaces on monitors; that is all.
#
# Anything a previous version recorded is handed back rather than dropped, by
# writing it where SUPER+L would have, so the screen keeps doing what it did.
LAYOUT_STATE="${OMARCHY_WORKSPACE_LAYOUTS:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/workspace-layouts}"

migrate_layouts() {
  jq -e 'has("layouts") or any((.profiles // [])[]; has("scrollable")) or has("scrollable")' \
    "$CONFIG" >/dev/null 2>&1 || return 0

  local handed=0 ws layout
  while IFS=$'\t' read -r ws layout; do
    [[ -n $ws && -n $layout ]] || continue
    mkdir -p "$LAYOUT_STATE"
    printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$ws" "$layout" \
      >"$LAYOUT_STATE/$ws.lua"
    handed=$((handed + 1))
  done < <(jq -r '
    # Both shapes: the per-workspace map, and the older per-monitor list whose
    # monitors each imply scrolling for everything they hold.
    ((.layouts // {}) | to_entries | map({ ws: .key, layout: .value })) as $direct
    | ([ (.profiles // [.])[]
         | . as $p
         | (($p.scrollable // []) | map($p.monitors[.] // []) | add // [])[]
         | { ws: (. | tostring), layout: "scrolling" } ]) as $viaMonitor
    | ($viaMonitor + $direct)
    | unique_by(.ws)
    | .[] | .ws + "\t" + .layout' "$CONFIG")

  jq 'del(.layouts) | del(.scrollable)
      | (if has("profiles") then .profiles |= map(del(.layouts) | del(.scrollable)) else . end)' \
    "$CONFIG" | write_config

  ((handed)) && say "Handed $handed workspace layout(s) back to Omarchy's SUPER+L; this plugin no longer sets layouts."
  return 0
}

write_config() { # stdin = new json
  local tmp
  tmp=$(mktemp "${CONFIG}.XXXXXX")
  cat >"$tmp"
  jq -e . "$tmp" >/dev/null || { rm -f "$tmp"; die "refusing to write invalid JSON"; }
  mkdir -p "$(dirname "$CONFIG")"
  mv "$tmp" "$CONFIG"
}

# OMARCHY_WORKSPACES_MONITORS stands in for Hyprland's answer where there is
# no Hyprland to ask, the way the tests run.
monitors_json() {
  if [[ -n ${OMARCHY_WORKSPACES_MONITORS:-} ]]; then cat "$OMARCHY_WORKSPACES_MONITORS"; else hyprctl monitors -j; fi
}

# Resolve a config selector ("eDP-1" or "desc:Some Monitor SERIAL") to the
# connected output name, or empty when that monitor is not plugged in.
resolve_selector() {
  local selector=$1
  monitors_json | jq -r --arg sel "$selector" '
    if ($sel | startswith("desc:")) then
      ($sel | ltrimstr("desc:")) as $d
      | [ .[] | select(.description == $d or (.description | startswith($d))) | .name ] | first // ""
    else
      [ .[] | select(.name == $sel) | .name ] | first // ""
    end'
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_detect() {
  [[ -f $CONFIG && ${FORCE:-0} -eq 0 ]] && die "$CONFIG already exists (pass --force to overwrite)"
  local count=${COUNT:-$KEY_SLOTS}
  [[ $count =~ ^[0-9]+$ ]] && ((count > 0)) || die "--count takes a positive number"

  # Spread 1..10 evenly over the connected monitors, left to right, and add a
  # single-monitor fallback profile for every monitor so undocking never
  # strands a workspace.
  monitors_json | jq --argjson c "$count" '
    def selector: if (.description | length) > 0 then "desc:" + .description else .name end;
    ( sort_by(.x) ) as $mons
    | ($mons | length) as $n
    | [ range(0; $n) as $i
        | { key: ($mons[$i] | selector),
            value: [ range(1; $c + 1) | select((. - 1) * $n / $c | floor == $i) ] } ]
      | from_entries as $docked
    | { version: 1, count: $c, persistent: true, monitors: $docked }' | write_config

  say "Wrote $CONFIG from the ${1:-currently} connected monitors."
  cmd_list
}

cmd_list() {
  ensure_config
  echo
  jq -r '
    ((.disabled // []) | map({ key: (. | tostring), value: true }) | from_entries) as $off
    | .monitors | to_entries[]
    | "  " + (.key | if startswith("desc:") then ltrimstr("desc:") else . end)
      + "\n      " + ([.value[]
          | (if . == 10 then "0" else tostring end) as $label
          | (if $off[. | tostring] then "(" + $label + ")" else $label end)] | join("  "))
      + "\n"' "$CONFIG"
  echo "  (n) is switched off."
  echo
}

cmd_status() {
  ensure_config
  echo "Config:   $CONFIG"
  echo "Lua:      $GENERATED"
  echo
  printf '%-6s %-10s %-10s %s\n' "WS" "HOME" "ACTUAL" ""
  local ws sel home actual
  for ws in $(managed_workspaces); do
    sel=$(selector_of "$ws")
    [[ -z $sel ]] && continue
    if jq -e --argjson w "$ws" '((.disabled // []) | index($w)) != null' "$CONFIG" >/dev/null; then
      printf '%-6s %-10s %-10s %s\n' "$ws" "$(resolve_selector "$sel")" "-" "off"
      continue
    fi
    home=$(resolve_selector "$sel")
    actual=$(hyprctl workspaces -j | jq -r --argjson w "$ws" '.[] | select(.id == $w) | .monitor')
    [[ -z $actual ]] && actual="-"
    # A workspace whose own monitor is unplugged has reflowed somewhere else.
    # That is correct behaviour, not drift, so it is named rather than flagged.
    printf '%-6s %-10s %-10s %s\n' "$ws" "${home:-offline}" "$actual" \
      "$(if [[ -z $home ]]; then echo 'reflowed — its monitor is unplugged'
         elif [[ $actual != "-" && $actual != "$home" ]]; then echo '← misplaced'; fi)"
  done
}

# expand "1-4" / "1,2,3" / "1 2 3" into a JSON array
expand_range() {
  local out=()
  local tok
  for tok in $(tr ',' ' ' <<<"$*"); do
    if [[ $tok =~ ^([0-9]+)-([0-9]+)$ ]]; then
      local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
      ((a <= b)) || die "bad range '$tok'"
      for ((n = a; n <= b; n++)); do out+=("$n"); done
    elif [[ $tok =~ ^[0-9]+$ ]]; then
      out+=("$((tok == 0 ? KEY_SLOTS : tok))")
    else
      die "not a workspace number or range: '$tok'"
    fi
  done
  ((${#out[@]})) || die "no workspaces given"
  printf '%s\n' "${out[@]}" | jq -Rn '[inputs | tonumber] | unique'
}

# Accept a live output name and give back the stable desc: selector for it, so
# nothing stored in the config depends on an output name that can move.
selector_for() {
  local monitor=$1 desc
  desc=$(monitors_json | jq -r --arg m "$monitor" '.[] | select(.name == $m) | .description' || true)
  if [[ -n $desc && $desc != "null" ]]; then echo "desc:$desc"; else echo "$monitor"; fi
}

cmd_assign() {
  ensure_config
  local monitor=${1:?usage: assign <monitor> <workspaces>}; shift
  local wanted; wanted=$(expand_range "$@")
  local selector; selector=$(selector_for "$monitor")

  jq --arg m "$selector" --argjson ws "$wanted" '
    .monitors |= (with_entries(.value -= $ws) | .[$m] = ((.[$m] // []) + $ws | unique)
                  | with_entries(select(.value | length > 0)))' "$CONFIG" | write_config

  say "Assigned $(tr '\n' ' ' <<<"$(jq -r '.[]' <<<"$wanted")")to $monitor."
}

# Workspaces this plugin speaks for in the active profile: everything the
# profile assigns to a monitor, disabled ones included. Used to decide which of
# Omarchy's saved layout overrides are ours to clear.
managed_workspaces() {
  jq -r '[.monitors[][]] | unique | .[]' "$CONFIG"
}

# The selector this layout puts a given workspace on, empty if none does.
selector_of() {
  jq -r --argjson w "$1" \
    '.monitors | to_entries[] | select(.value | index($w)) | .key' "$CONFIG"
}

# Turn workspaces on or off. A disabled workspace keeps its place on a monitor
# — the editor still draws the pill there — but gets no rule and no keybinding,
# so it cannot be reached or created at all.
cmd_workspace_state() {
  ensure_config
  local wanted_off=$1; shift
  local wanted; wanted=$(expand_range "$@")

  jq --argjson ws "$wanted" --argjson off "$wanted_off" '
    .disabled = (
      if $off then (((.disabled // []) + $ws) | unique)
      else ((.disabled // []) - $ws) end)
    | (if (.disabled | length) == 0 then del(.disabled) else . end)' "$CONFIG" | write_config

  say "$(if [[ $wanted_off == true ]]; then echo Disabled; else echo Enabled; fi)$(tr '\n' ' ' <<<"$(jq -r '" " + (.[]|tostring)' <<<"$wanted")")."
}

GENERATED_MARKER="GENERATED BY omarchy-workspaces"

# True when $GENERATED is absent or carries our banner — i.e. when replacing it
# throws away nothing a human wrote.
generated_by_us() {
  [[ -f $GENERATED ]] || return 0
  head -1 "$GENERATED" | grep -q "$GENERATED_MARKER"
}

cmd_generate() {
  ensure_config
  mkdir -p "$(dirname "$GENERATED")"
  {
    cat <<'LUA'
-- GENERATED BY omarchy-workspaces — DO NOT EDIT.
-- Edit ~/.config/omarchy/workspaces.json instead; the plugin's shell service
-- picks the change up and regenerates this file.
--
-- Pins each workspace to a home monitor. Monitors are matched by description
-- (serial included) so identical displays keep their identity across reboots
-- and dock reconnects. A monitor that is not plugged in has its workspaces
-- reflow onto the nearest one that is, and get them back when it returns.

local monitors = {
LUA
    jq -r '
      .monitors | to_entries | map(
        "  { selector = " + (.key | @json) + ", workspaces = { " +
        (.value | map(tostring) | join(", ")) + " } },") | join("\n")' "$CONFIG"
    cat <<'LUA'
}
LUA
    jq -r '
      "local disabled_list = { " + (((.disabled // []) | map(tostring)) | join(", ")) + " }"' "$CONFIG"
    local persistent
    persistent=$(jq -r 'if .persistent == false then "false" else "true" end' "$CONFIG")
    cat <<LUA

local persistent = $persistent
local key_slots = $KEY_SLOTS
LUA
    cat <<'LUA'

local disabled = {}
for _, ws in ipairs(disabled_list) do disabled[ws] = true end

local function connected()
  local byName, descs = {}, {}
  for _, m in ipairs(hl.get_monitors() or {}) do
    -- Tools that dry-run hyprland.lua (omarchy-menu-keybindings) stub hl with
    -- a table whose every index is non-nil, so ipairs would never end.
    -- Real monitors are userdata, so test the field rather than the type.
    if type(m.name) ~= "string" then break end
    byName[m.name] = m
    descs[#descs + 1] = { desc = m.description or "", monitor = m }
  end
  return byName, descs
end

local function resolve(selector, byName, descs)
  if selector:sub(1, 5) == "desc:" then
    local want = selector:sub(6)
    for _, entry in ipairs(descs) do
      if entry.desc == want or entry.desc:sub(1, #want) == want then return entry.monitor end
    end
    return nil
  end
  return byName[selector]
end

-- Where each workspace actually goes right now.
--
-- The layout says which monitor owns what. A monitor that is not plugged in
-- owns nothing it can hold, so its workspaces reflow onto the nearest monitor
-- that is — nearest by position in the layout, which is written left to right,
-- preferring the neighbour to the left. Nothing is written to disk when this
-- happens: the layout is still the layout, and plugging the monitor back in
-- puts its workspaces home again.
local function placement()
  local byName, descs = connected()
  local live, present = {}, {}
  for i, group in ipairs(monitors) do
    live[i] = resolve(group.selector, byName, descs)
    if live[i] then present[#present + 1] = i end
  end
  if #present == 0 then return nil end

  -- Distance doubled so the +1 only ever breaks a tie, never outranks a
  -- genuinely closer monitor on the right.
  local function nearest(from)
    local best, bestDistance
    for _, i in ipairs(present) do
      local distance = math.abs(i - from) * 2 + (i > from and 1 or 0)
      if not bestDistance or distance < bestDistance then best, bestDistance = i, distance end
    end
    return best
  end

  local out, index = {}, {}
  for _, i in ipairs(present) do
    index[live[i].name] = #out + 1
    out[#out + 1] = { monitor = live[i], workspaces = {} }
  end
  for i, group in ipairs(monitors) do
    local target = live[i] and i or nearest(i)
    local slot = out[index[live[target].name]]
    for _, ws in ipairs(group.workspaces) do
      if not disabled[ws] then slot.workspaces[#slot.workspaces + 1] = ws end
    end
  end
  for _, slot in ipairs(out) do table.sort(slot.workspaces) end
  return out
end

local groups = placement()

-- Which layout a workspace tiles with is deliberately not set here. Naming it
-- would overwrite whatever SUPER+L last chose on every reload, and that key is
-- Omarchy's, saved in its own state directory and applied after this file.
-- Leaving it out is what lets the two coexist.
local function apply_rules()
  if not groups then return end
  for _, group in ipairs(groups) do
    for _, ws in ipairs(group.workspaces) do
      if not disabled[ws] then
        hl.workspace_rule({
          workspace = tostring(ws),
          monitor = group.monitor.name,
          default = true,
          persistent = persistent,
        })
      end
    end
  end
end

apply_rules()

-- Rules only bind a workspace at creation time, so anything that already
-- exists (or drifted after a hotplug) is walked home once the config settles.
local function rehome()
  local current = placement()
  if not current then return end
  for _, group in ipairs(current) do
    for _, ws in ipairs(group.workspaces) do
      if not disabled[ws] then
        local workspace = hl.get_workspace(tostring(ws))
        if workspace and workspace.monitor and workspace.monitor.name ~= group.monitor.name then
          hl.dispatch(hl.dsp.workspace.move({ workspace = tostring(ws), monitor = group.monitor.name }))
        end
      end
    end
  end
end

-- A monitor that comes back is handed a fresh workspace of its own, and it
-- stays there after rehome brings its real ones back, showing a workspace the
-- layout never mentions. Show the first one it owns instead, then put focus
-- back: no dispatcher changes another monitor's workspace without focusing
-- it. Omarchy's laptop-display toggle brings a screen back with a reload, not
-- a hotplug event, so this runs on every settle — and only ever leaves an
-- empty workspace, which costs nothing, so a reload never takes a screen off
-- something someone was using.
local function reveal()
  local current = placement()
  if not current then return end

  local owned = {}
  for _, group in ipairs(current) do
    for _, ws in ipairs(group.workspaces) do owned[ws] = group end
  end

  local focused = hl.get_active_workspace()
  local switched = false
  for _, group in ipairs(current) do
    local active = group.monitor.active_workspace
    if active and active.id > 0 and active.windows == 0 and owned[active.id] ~= group
      and group.workspaces[1] then
      hl.dispatch(hl.dsp.focus({ workspace = tostring(group.workspaces[1]) }))
      switched = true
    end
  end

  -- If the stray workspace was the focused one, focus stays where it landed:
  -- going back would only create it again.
  if switched and focused and owned[focused.id] then
    hl.dispatch(hl.dsp.focus({ workspace = tostring(focused.id) }))
  end
end

-- A disabled workspace has to be unreachable, not merely unpinned: with the
-- key still bound, SUPER+4 would create workspace 4 on whatever monitor is
-- focused, which is the placement this plugin exists to prevent. Only the
-- unbind is needed — a reload re-runs Omarchy's bindings and restores every
-- key, so this pass just takes the disabled ones back out again afterwards.
-- Which workspaces the layout actually speaks for. A key slot that
-- is not in here belongs to nobody: either it is switched off, or the config
-- has fewer workspaces than Omarchy has keys. Both want the same treatment,
-- because a bound key with no rule behind it opens a workspace on whatever
-- monitor happens to be focused — the placement this plugin exists to prevent.
local function managed()
  local set = {}
  if groups then
    for _, group in ipairs(groups) do
      for _, ws in ipairs(group.workspaces) do set[ws] = true end
    end
  end
  return set
end

local function apply_binds()
  local mine = managed()
  for ws = 1, key_slots do
    if disabled[ws] or not mine[ws] then
      local code = "code:" .. tostring(ws + 9)
      hl.unbind("SUPER + " .. code)
      hl.unbind("SUPER + SHIFT + " .. code)
      hl.unbind("SUPER + SHIFT + ALT + " .. code)
    end
  end

end

-- Rules are re-asserted once the config has settled, because plenty of things
-- load after this file and a workspace can be created in between.
local function settle()
  apply_rules()
  apply_binds()
  rehome()
  reveal()
end

hl.timer(settle, { timeout = 500, type = "oneshot" })

-- A monitor coming or going changes where everything reflows to, so the rules
-- are rebuilt in place. No reload: the layout on disk has not changed, only
-- which monitors are answering, and re-deriving is both faster and free of the
-- loop risk a reload carries. The hooked flag keeps `hyprctl reload` from
-- stacking a second copy of these subscriptions.
_G.__omarchy_workspaces = _G.__omarchy_workspaces or {}
local state = _G.__omarchy_workspaces

local function on_monitor_change()
  hl.timer(function()
    groups = placement()
    settle()
  end, { timeout = 400, type = "oneshot" })
end

if not state.hooked then
  state.hooked = true
  hl.on("monitor.added", on_monitor_change)
  hl.on("monitor.removed", on_monitor_change)
end
LUA
  } >"$GENERATED"
  say "Generated $GENERATED"
}

ensure_required() {
  local main="$HOME/.config/hypr/hyprland.lua"
  [[ -f $main ]] || die "missing $main"
  grep -q 'hypr.workspaces' "$main" && return 1
  cat >>"$main" <<'LUA'

-- Workspace-to-monitor pinning. Generated by omarchy-workspaces; the require is
-- optional so a missing/renamed workspaces.lua can never break the whole config.
require("default.hypr.require_optional").module("hypr.workspaces")
LUA
  say "Hooked workspaces.lua into hyprland.lua"
  return 0
}

# Walk any workspace that is not on its home monitor back onto it. Workspace
# rules only bind at creation time, so anything already open when the rules
# change has to be moved by hand.
rehome_workspaces() {
  local ws sel home actual
  for ws in $(managed_workspaces); do
    sel=$(selector_of "$ws")
    [[ -z $sel ]] && continue
    home=$(resolve_selector "$sel")
    # Unplugged: the generated Lua has already reflowed it somewhere sensible,
    # and second-guessing that from here would only fight it.
    [[ -z $home ]] && continue
    actual=$(hyprctl workspaces -j | jq -r --argjson w "$ws" '.[] | select(.id == $w) | .monitor')
    [[ -n $actual && $actual != "$home" ]] &&
      hyprctl dispatch "hl.dsp.workspace.move({ workspace = \"$ws\", monitor = \"$home\" })" >/dev/null
  done
  # The loop's last statement is a test that is false whenever nothing needed
  # moving, which under `set -e` would take the caller down with it.
  return 0
}

reload_hyprland() {
  hyprctl reload >/dev/null
  local errors
  errors=$(hyprctl configerrors)
  if [[ $errors != "no errors" && -n $errors ]]; then
    echo "$errors" >&2
    die "Hyprland reported config errors (see above)"
  fi
}

cmd_apply() {
  cmd_generate
  ensure_required || true
  reload_hyprland
  # Nudge already-open workspaces onto their home monitor right away rather
  # than waiting for the lua timer.
  rehome_workspaces
  # Deliberately no `rescanPlugins` here. That reloads plugin *code*, and doing
  # it during a config change races the bar's in-place settings patch: the patch
  # lands on the bar's layout copy but not on the widget being torn down, and
  # because the next reload then sees no delta, nothing ever reconciles it. The
  # widget watches workspaces.json itself, so there is nothing to nudge.

  # Claiming success was the habit that let every previous bug hide. Ask before
  # saying it: the rules are in, but something else on this machine may have
  # had the last word. The settle timer in the generated Lua has to land first.
  sleep 1
  local report
  if report=$(QUIET=1 cmd_doctor 2>&1); then
    say "Applied."
  else
    echo "omarchy-workspaces: applied, but the result does not match:" >&2
    grep '✗' <<<"$report" >&2
    echo "  (run 'omarchy-workspaces doctor' for the full picture)" >&2
    return 1
  fi
}

# What the shell service runs at startup and whenever workspaces.json changes.
# `omarchy plugin add` never runs an install hook, so enabling the plugin has to
# be the whole setup: seed a config from the connected monitors on a first run,
# keep workspaces.lua in step with the config, and hook it into hyprland.lua.
#
# Idempotent by construction — it reloads Hyprland only when the generated Lua
# actually came out different, so the every-shell-start case costs one diff and
# touches nothing.
cmd_bootstrap() {
  local changed=0

  # Someone may already pin workspaces by hand — that is a perfectly good way to
  # do this, and it is the file this plugin wants to own. Unattended is the
  # wrong moment to overwrite it, so bootstrap stops and says so; `apply` is
  # where the user has actually asked for the replacement.
  if ! generated_by_us; then
    echo "omarchy-workspaces: $GENERATED was not generated by this plugin — leaving it alone." >&2
    echo "omarchy-workspaces: run 'omarchy-workspaces apply' to replace it with generated rules." >&2
    return 0
  fi

  if [[ ! -f $CONFIG ]]; then
    FORCE=1 QUIET=1 cmd_detect >/dev/null
    say "Seeded $CONFIG from the connected monitors."
    changed=1
  fi

  local before=""
  [[ -f $GENERATED ]] && before=$(cat "$GENERATED")
  QUIET=1 cmd_generate
  [[ $before == "$(cat "$GENERATED")" ]] || changed=1

  ensure_required && changed=1
  cmd_bind_overview && changed=1

  if ((changed)); then
    reload_hyprland
    rehome_workspaces
    say "Bootstrapped: workspace rules are in sync."
  else
    say "Already in sync."
  fi
}

# ── doctor ───────────────────────────────────────────────────────────────────
#
# Compare what the config asks for against what Hyprland is actually doing.
#
# Everything this plugin writes lands in files it does not own, next to other
# things that write to the same places — Omarchy's SUPER+L layout toggle, a
# hand-edited monitors.lua, whatever put a workspace somewhere at login. When
# one of those wins, nothing announces it: `apply` reloads, prints "Applied",
# and the disagreement sits there until someone notices the screen is not doing
# what the config says. Every bug this plugin has had was that shape.
#
# So: ask, do not assume. Exit 1 on any drift so `apply` can refuse to claim
# success and a keybinding or hook can notice too.

DOCTOR_PROBLEMS=0
ok()    { say "  ✓ $*"; }
bad()   { echo "  ✗ $*" >&2; DOCTOR_PROBLEMS=$((DOCTOR_PROBLEMS + 1)); }

cmd_doctor() {
  ensure_config
  DOCTOR_PROBLEMS=0
  say "Config:   $CONFIG"
  say ""

  # ── the generated file still says what we would generate now ──────────────
  if ! generated_by_us; then
    bad "$GENERATED was not generated by this plugin — 'apply' would replace it"
  else
    local tmp live; tmp=$(mktemp); live="$GENERATED"
    GENERATED="$tmp" QUIET=1 cmd_generate
    if diff -q "$tmp" "$live" >/dev/null 2>&1; then
      ok "workspaces.lua matches the config"
    else
      bad "workspaces.lua is stale — the config changed since the last apply"
    fi
    rm -f "$tmp"
  fi

  grep -q 'hypr.workspaces' "$HOME/.config/hypr/hyprland.lua" 2>/dev/null \
    && ok "hyprland.lua requires hypr.workspaces" \
    || bad "hyprland.lua does not require hypr.workspaces — no rule is being applied"

  # ── the layout itself, before anything is compared to a screen ───────────
  local faults
  faults=$(jq -r '
    ([.monitors[][]]) as $all
    | (
        # A workspace on two monitors at once has no home, which is the one
        # thing this plugin promises.
        ( $all | group_by(.) | map(select(length > 1) | .[0]) | sort
          | if length > 0 then
              [ "workspace " + (map(tostring) | join(", ")) + " is on two monitors" ]
            else [] end )
        # Switching off, or pinning the layout of, a workspace the layout never
        # places is a line that will never do anything.
        + ( ((.disabled // []) - ($all | unique)) | sort
            | if length > 0 then
                [ "disabled workspace " + (map(tostring) | join(", ")) + " is not in the layout" ]
              else [] end )
        + ( if ((.monitors // {}) | length) == 0 then [ "the layout places no workspaces at all" ] else [] end )
      ) | .[]' "$CONFIG")

  if [[ -n $faults ]]; then
    while IFS= read -r line; do [[ -n $line ]] && bad "$line"; done <<<"$faults"
  else
    ok "the layout is self-consistent"
  fi

  # Everything above holds whatever is plugged in. Everything below compares
  # against a running compositor, which needs at least one monitor answering.
  if [[ $(monitors_json | jq 'length') == 0 ]]; then
    bad "no monitors are connected"
    say ""
    echo "$DOCTOR_PROBLEMS problem(s)." >&2
    return 1
  fi

  # ── live state, gathered once ─────────────────────────────────────────────
  local live_place live_exists live_binds
  live_place=$(hyprctl workspaces -j | jq -r '[.[] | select(.id > 0) | "\(.id)=\(.monitor)"] | join(" ")')
  live_exists=$(hyprctl repl "local o = {} for i = 1, $KEY_SLOTS do
    o[#o+1] = i .. \"=\" .. (hl.get_workspace(tostring(i)) and \"yes\" or \"gone\") end
    return table.concat(o, \" \")" 2>/dev/null)
  live_binds=$(hyprctl binds -j | jq -r '[.[] | select(.description | test("^Switch to workspace "))
    | (.description | sub("^Switch to workspace ";""))] | join(" ")')

  local misplaced=() stillbound=() unbound=() pinned=0 off=0
  for ws in $(managed_workspaces); do
    local sel; sel=$(selector_of "$ws")
    [[ -z $sel ]] && continue

    local is_off="false"
    jq -e --argjson w "$ws" '((.disabled // []) | index($w)) != null' "$CONFIG" >/dev/null && is_off="true"

    local bound="false"
    [[ " $live_binds " == *" $ws "* ]] && bound="true"

    if [[ $is_off == true ]]; then
      off=$((off + 1))
      [[ $bound == true ]] && stillbound+=("$ws")
      [[ " $live_exists " == *" $ws=gone "* ]] || misplaced+=("$ws exists but is switched off")
      continue
    fi

    pinned=$((pinned + 1))
    [[ $bound == false ]] && unbound+=("$ws")

    local home actual
    home=$(resolve_selector "$sel")
    # Its monitor is unplugged, so it has reflowed elsewhere. Intended.
    [[ -z $home ]] && continue
    actual=$(sed -n "s/.*\b$ws=\([^ ]*\).*/\1/p" <<<"$live_place")
    [[ -n $actual && $actual != "$home" ]] && misplaced+=("$ws on $actual, home is $home")

  done

  ((${#misplaced[@]})) && bad "placement: ${misplaced[*]}" || ok "placement: all $pinned workspaces on their home monitor"
  ((${#stillbound[@]})) && bad "keys: workspace ${stillbound[*]} switched off but still bound"
  ((${#unbound[@]})) && bad "keys: workspace ${unbound[*]} enabled but has no keybinding"
  ((${#stillbound[@]} + ${#unbound[@]})) || ok "keys: $pinned bound, $off unbound"

  say ""
  if ((DOCTOR_PROBLEMS)); then
    echo "$DOCTOR_PROBLEMS problem(s). Run 'omarchy-workspaces apply' to reconcile." >&2
    return 1
  fi
  say "Everything matches."
  return 0
}

cmd_edit() {
  ensure_config
  omarchy-launch-config-editor "$CONFIG"
}


# Replace a whole profile in one shot. This is what the overlay calls when you
# hit Apply: it hands over the entire monitor -> workspaces map rather than a
# stream of per-monitor edits, so a half-applied layout is not possible.
#
# Keys are live output names; they are stored as desc: selectors, because the
# overlay speaks in the names Hyprland is using right now and the config has to
# survive those names changing.
cmd_set_layout() {
  ensure_config
  local payload="" offs=""
  while (($#)); do
    case $1 in
      --base64)  payload=$(base64 -d <<<"${2:?--base64 needs a value}"); shift 2 ;;
      --disabled-base64)
                 offs=$(base64 -d <<<"${2:?--disabled-base64 needs a value}"); shift 2 ;;
      *)         payload=$1; shift ;;
    esac
  done
  [[ -n $payload ]] || die "set-layout needs a JSON object of monitor -> workspaces"
  jq -e 'type == "object"' <<<"$payload" >/dev/null 2>&1 || die "set-layout payload is not a JSON object"

  local monitors mapped
  monitors=$(monitors_json)
  mapped=$(jq -n --argjson layout "$payload" --argjson mons "$monitors" '
    ( $mons
      | map(select((.description // "") != "") | { key: .name, value: ("desc:" + .description) })
      | from_entries ) as $selector
    | $layout
    | with_entries(
        .key = ($selector[.key] // .key)
        | .value |= (map(tonumber) | unique))
    | with_entries(select(.value | length > 0))')

  # Only the monitors the editor can see are replaced. One that is unplugged
  # is not absent from the desk, only from this screen, and dropping its
  # workspaces because they were not in a payload that could never have
  # mentioned them would lose the layout every time you edited while undocked.
  jq --argjson m "$mapped" '
    ($m | keys) as $touched
    | .monitors = (
        (.monitors | with_entries(select(.key as $k | ($touched | index($k)) == null)))
        + $m)
    | .monitors |= with_entries(.value |= (map(select(. != null)) | unique))' "$CONFIG" | write_config

  if [[ -n $offs ]]; then
    jq -e 'type == "array"' <<<"$offs" >/dev/null 2>&1 ||
      die "--disabled-base64 payload is not a JSON array"
    jq --argjson d "$offs" '
      if ($d | length) == 0 then del(.disabled) else .disabled = ($d | map(tonumber) | unique) end' \
      "$CONFIG" | write_config
  fi

  say "Replaced the layout."
}

cmd_open() {
  omarchy-shell shell summon "$PLUGIN_ID" '{}' >/dev/null 2>&1 ||
    die "could not summon the overlay (is omarchy-shell running?)"
}

# Summon, and the overlay toggles: a summon while it is up closes it, unless it
# lands so soon after opening that it is the same press arriving twice. A
# toggle in the shell cannot tell those apart. See open() in Overlay.qml.
cmd_overview() {
  omarchy-shell shell summon "$PLUGIN_ID" "$OVERVIEW_PAYLOAD" >/dev/null 2>&1 ||
    die "could not open the overview (is omarchy-shell running?)"
}

# ── the overview shortcut ────────────────────────────────────────────────────
#
# Offered once, not enforced. The first bootstrap writes one o.bind block to
# bindings.lua, under the `-- Name (<id>)` comment Plugin Manager takes for a
# plugin's own binding, so it can be moved or removed there like any other. A
# flag in the state directory records that the offer was made: a removal has to
# stick, and without the flag the next shell start would put it straight back.
# `bind-overview --force` makes the offer again.
#
# Returns 0 only when it wrote something, so bootstrap knows to reload.

overview_bind_line() {
  printf 'o.bind("%s", "Workspace overview", "omarchy-shell shell summon %s '\''%s'\''")\n' \
    "$OVERVIEW_KEY" "$PLUGIN_ID" "${OVERVIEW_PAYLOAD//\"/\\\"}"
}

# Hyprland cannot say what holds a key here: with a Lua config, `hyprctl binds`
# reports every binding with an empty key, Omarchy's own SUPER+1..0 included.
# So the files are asked instead — yours next to bindings.lua, and Omarchy's
# defaults — for a binding of SUPER alone on this key, by position or by name.
overview_key_taken() {
  #
  # Only files that exist go to grep. A glob that matches nothing stays a
  # literal path, and grep exits 2 for a missing file even after a match in
  # another, so a taken key would read as free.
  local files=() file
  for file in "$(dirname "$BINDINGS")"/*.lua "${OMARCHY_PATH:-/usr/share/omarchy}"/default/hypr/*.lua; do
    [[ -f $file ]] && files+=("$file")
  done
  ((${#files[@]})) || return 1
  grep -qiE '^\s*(o|hl)\.bind\(\s*"SUPER\s*\+\s*(code:49|grave)\s*"' "${files[@]}"
}

cmd_bind_overview() {
  local flag="$STATE_DIR/overview-key"
  [[ -f $BINDINGS ]] || return 1
  mkdir -p "$STATE_DIR"

  # Already there, under whatever key it has been moved to since.
  if grep -qE "^o\.bind\(.*${PLUGIN_ID//./\\.} .*overview" "$BINDINGS"; then
    touch "$flag"
    return 1
  fi
  [[ -e $flag ]] && ! ((${FORCE:-0})) && return 1

  touch "$flag"
  if overview_key_taken; then
    echo "omarchy-workspaces: $OVERVIEW_KEY is taken, so the overview has no shortcut." >&2
    echo "omarchy-workspaces: give it one with Plugin Manager, or bind 'omarchy-workspaces overview'." >&2
    return 1
  fi

  # The newline after the line is ours to add: $(...) strips it, and without
  # it the next thing appended to the file lands on the same line.
  printf '\n-- Workspaces (%s)\n%s\n' "$PLUGIN_ID" "$(overview_bind_line)" >>"$BINDINGS"
  say "Bound the workspace overview to $OVERVIEW_KEY in $BINDINGS"
}

# ── the shortcut, as the editor shows it ─────────────────────────────────────
#
# Read from the files, like overview_key_taken and for the same reason, and
# from wherever the line has been moved to since. A `code:N` key is named by
# what the current layout prints on it: `code:49` means nothing to anyone, and
# `½` or `` ` `` is the key under your finger.

keysym_char() {
  case $1 in
    grave | dead_grave) echo '`' ;;
    asciitilde) echo '~' ;;
    onehalf) echo '½' ;;
    section) echo '§' ;;
    twosuperior) echo '²' ;;
    asciicircum | dead_circumflex) echo '^' ;;
    degree) echo '°' ;;
    apostrophe) echo "'" ;;
    bar) echo '|' ;;
    less) echo '<' ;;
    minus) echo '-' ;;
    equal) echo '=' ;;
    ?) echo "${1^^}" ;;
    *) echo "$1" ;;
  esac
}

# The main keyboard's layout, from Hyprland. OMARCHY_WORKSPACES_XKB_LAYOUT
# stands in for it where there is no Hyprland to ask.
keycode_label() {
  local code=$1 layout variant keymap name sym
  layout=${OMARCHY_WORKSPACES_XKB_LAYOUT:-$(hyprctl devices -j 2>/dev/null |
    jq -r '[.keyboards[] | select(.main)][0].layout // empty' 2>/dev/null || true)}
  variant=${OMARCHY_WORKSPACES_XKB_VARIANT-$(hyprctl devices -j 2>/dev/null |
    jq -r '[.keyboards[] | select(.main)][0].variant // empty' 2>/dev/null || true)}
  if [[ -z $layout ]] || ! command -v xkbcli >/dev/null; then
    echo "code:$code"
    return
  fi
  keymap=$(xkbcli compile-keymap --layout "${layout%%,*}" ${variant:+--variant "${variant%%,*}"} 2>/dev/null || true)
  # `<TLDE> = 49;` in the keycodes, then `key <TLDE> { [ onehalf, ...` in the
  # symbols. The first symbol is the unshifted one, which is what is printed.
  name=$(awk -v c="$code" '$0 ~ "= " c ";" && match($0, /<[^>]+>/) { print substr($0, RSTART, RLENGTH); exit }' <<<"$keymap")
  sym=$(awk -v n="key $name" 'n != "key " && index($0, n) && match($0, /\[[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*[,\]]/) {
    s = substr($0, RSTART + 1, RLENGTH - 2); gsub(/[ \t]/, "", s); print s; exit }' <<<"$keymap")
  if [[ -n $sym ]]; then keysym_char "$sym"; else echo "code:$code"; fi
}

cmd_overview_key() {
  local line keys part out=()
  line=$(grep -hsE "^o\.bind\(.*${PLUGIN_ID//./\\.} .*overview" "$(dirname "$BINDINGS")"/*.lua | head -1 || true)
  keys=$(sed -E 's/^o\.bind\(\s*"([^"]*)".*/\1/' <<<"$line")
  [[ -n $line && -n $keys ]] || return 1
  IFS='+' read -ra parts <<<"$keys"
  for part in "${parts[@]}"; do
    part=${part#"${part%%[![:space:]]*}"}
    part=${part%"${part##*[![:space:]]}"}
    [[ $part =~ ^code:([0-9]+)$ ]] && part=$(keycode_label "${BASH_REMATCH[1]}")
    out+=("$part")
  done
  printf '%s' "${out[0]}"
  printf ' + %s' "${out[@]:1}"
  echo
}

# ── presets ──────────────────────────────────────────────────────────────────
#
# A preset is the desk as it was: which apps were open on which workspace, in
# what order, and where the floating ones sat. It is saved from the overview
# and restored from it — typically after a reboot, onto an empty desk.
#
# It has a file of its own rather than a key in workspaces.json, because the
# shell service reloads Hyprland whenever workspaces.json changes, and saving
# a preset changes nothing about where workspaces go.

PRESETS="${OMARCHY_WORKSPACES_PRESETS:-$HOME/.config/omarchy/workspace-presets.json}"
# How long one app gets to put up a window before restore moves on without
# it. A browser restoring its own session on a cold boot is the slow case.
LAUNCH_TIMEOUT=${OMARCHY_WORKSPACES_LAUNCH_TIMEOUT:-20}
NOTIFY=0

# A missing file is no presets yet. A broken one is refused rather than read
# as empty, since the next save would then write over every preset in it.
presets_json() {
  if [[ ! -f $PRESETS ]]; then
    echo '{"version":1,"presets":{}}'
    return
  fi
  jq -e '.version == 1 and (.presets | type == "object")' "$PRESETS" >/dev/null 2>&1 ||
    die "$PRESETS is not a version 1 presets file"
  cat "$PRESETS"
}

write_presets() { # stdin = new json
  local tmp
  mkdir -p "$(dirname "$PRESETS")"
  tmp=$(mktemp "${PRESETS}.XXXXXX")
  cat >"$tmp"
  jq -e '.version == 1' "$tmp" >/dev/null || { rm -f "$tmp"; die "refusing to write an invalid presets file"; }
  mv "$tmp" "$PRESETS"
}

# OMARCHY_WORKSPACES_CLIENTS is the test hook, as OMARCHY_WORKSPACES_MONITORS
# is for monitors_json.
clients_json() {
  if [[ -n ${OMARCHY_WORKSPACES_CLIENTS:-} ]]; then cat "$OMARCHY_WORKSPACES_CLIENTS"; else hyprctl clients -j; fi
}

# Which layout each workspace tiles with, and on which monitor it is.
workspaces_json() {
  if [[ -n ${OMARCHY_WORKSPACES_WORKSPACES:-} ]]; then cat "$OMARCHY_WORKSPACES_WORKSPACES"; else hyprctl workspaces -j 2>/dev/null || echo '[]'; fi
}

dispatch() { hyprctl dispatch "$1" >/dev/null 2>&1 || true; }

# Only when asked: the overlay asks, because nobody sees its output. In a
# terminal the output says the same thing. It takes the place of the restore's
# progress notification, when there is one.
notify() {
  ((NOTIFY)) || return 0
  command -v omarchy-notification-send >/dev/null || return 0
  omarchy-notification-send -g "󰖳" ${PROGRESS_ID:+-r "$PROGRESS_ID"} "$@" >/dev/null 2>&1 || true
}

# One notification for a whole restore, updated in place as it goes, so it is
# never silent and never leaves a pile of toasts behind. It stays up until the
# summary replaces it. In a terminal the same line is printed.
PROGRESS_ID=""
progress() { # headline body
  say "  $2"
  ((NOTIFY)) || return 0
  command -v omarchy-notification-send >/dev/null || return 0
  local id
  id=$(omarchy-notification-send -g "󰖳" -t 0 -p ${PROGRESS_ID:+-r "$PROGRESS_ID"} "$1" "$2" 2>/dev/null |
    grep -oE '[0-9]+' | tail -1 || true)
  PROGRESS_ID=${id:-$PROGRESS_ID}
}

# The name as typed, trimmed. It is a JSON key and a button label, so it can
# be anything printable; only an empty or runaway one is refused.
preset_name() {
  local name=$1
  name=${name#"${name%%[![:space:]]*}"}
  name=${name%"${name##*[![:space:]]}"}
  [[ -n $name ]] || die "a preset needs a name"
  ((${#name} <= 40)) || die "a preset name is at most 40 characters"
  [[ $name != *[[:cntrl:]]* ]] || die "a preset name cannot contain control characters"
  printf '%s' "$name"
}

preset_get() {
  presets_json | jq -ce --arg n "$1" '.presets[$n] // empty' || die "there is no preset called “$1”"
}

# ── taking the snapshot ──────────────────────────────────────────────────────

# Which windows belong to the desk, and what is kept of each.
#
# A dialog is not part of anybody's desk. Everything with a parent window is
# one — Open, Save, Preferences — and the overlay, which can see parents,
# passes those addresses in as $skip. What is left to catch here is what has
# no parent because it comes from another process: the portal's file pickers,
# polkit and pinentry prompts. A title is only trusted on a floating window,
# since a browser's title is whatever page it happens to show.
#
# Omarchy's own terminal windows — btop, the package installer, TUI.float —
# are started by its keys and menus, which start them again better than a
# restore could. One restored without its program, under org.omarchy.btop,
# would even be focused by the btop key in place of btop. They are left out.
#
# Notifications, widgets and the bar are layer surfaces, not windows, so they
# never reach this list at all. Neither does the scratchpad: special
# workspaces are not places on the desk.
#
# Every position is kept relative to its monitor, so it lands right even
# after output names or the arrangement change. Tiled windows keep theirs too:
# the restore reads the layout back out of where they sat.
PRESET_SNAPSHOT_JQ='
  def addr: ascii_downcase | ltrimstr("0x");
  def tagged($t): (.tags // []) | map(rtrimstr("*")) | index($t) != null;
  def dialog_title:
    test("^(Open.*Files?|Open [Ff]older.*|Save.*Files?|Save.*As|Save|All Files|.*wants to (open|save).*|[Cc]hoose.*)");
  ($skip | map(tostring | addr)) as $skipped
  | ($mons | map({ key: (.id | tostring), value: . }) | from_entries) as $byId
  | (group_by(.pid) | map({ key: (.[0].pid | tostring), value: length }) | from_entries) as $perPid
  | [ .[]
      | select(.workspace.id > 0)
      | select((.hidden // false) | not)
      | select((.address | addr) as $a | $skipped | index($a) | not)
      | select((.class // "") != "")
      | select(.class | test("^(xdg-desktop-portal.*|.*polkit.*|pinentry.*|org\\.omarchy\\..*|TUI\\..*)$"; "i") | not)
      | select((.floating and ((.title // "") | dialog_title)) | not)
      | select(tagged("pip") | not)
      | ($byId[(.monitor | tostring)] // { x: 0, y: 0 }) as $m
      | { workspace: .workspace.id, class, title: (.title // ""), pid,
          stable: ((.stableId // "") | tostring),
          floating, fullscreen: (.fullscreen // 0), pinned: (.pinned // false),
          at: [ .at[0] - $m.x, .at[1] - $m.y ], size,
          terminal: tagged("terminal"),
          shared: ($perPid[(.pid | tostring)] > 1) } ]
  | sort_by(.workspace, (.stable | length), .stable)'

# A process's argv as a JSON array, or [] once it is gone. Read as raw text
# and split on NUL, never passed to jq as arguments: jq takes an argument
# like --app-id=… for one of its own options, and gives up.
proc_argv() {
  [[ -r /proc/$1/cmdline ]] || { echo '[]'; return; }
  unpack_argv "$(jq -Rsc 'split("\u0000") | if .[-1] == "" then .[:-1] else . end' "/proc/$1/cmdline" 2>/dev/null || echo '[]')"
}

# Chromium and Electron rewrite their own argv into a single string, spaces
# and all, which run as it stands is one long file name that does not exist.
# A lone argument whose first word is an executable is split back up.
unpack_argv() {
  local first
  first=$(jq -r 'if length == 1 and (.[0] | test(" ")) then .[0] | split(" ")[0] else "" end' <<<"$1")
  if [[ -n $first && -x $first && ! -e $(jq -r '.[0]' <<<"$1") ]]; then
    jq -c '.[0] | split(" ") | map(select(length > 0))' <<<"$1"
  else
    printf '%s\n' "$1"
  fi
}

# The process that owns the terminal's foreground: the tpgid of the shell,
# field 8 of its stat. That is nvim while nvim runs, and the shell itself at a
# prompt. Without a terminal to own (tpgid -1) it is the process itself.
foreground_of() {
  local stat rest tpgid
  stat=$(cat "/proc/$1/stat" 2>/dev/null) || { echo "$1"; return; }
  # The command name sits in parentheses and may hold spaces, so fields are
  # counted from after it: state ppid pgrp session tty tpgid.
  rest=${stat##*) }
  read -r _ _ _ _ _ tpgid _ <<<"$rest"
  if [[ $tpgid =~ ^[0-9]+$ ]] && ((tpgid > 0)) && [[ -d /proc/$tpgid ]]; then
    echo "$tpgid"
  else
    echo "$1"
  fi
}

PRESET_SHELLS=" bash zsh fish sh dash ksh mksh tcsh csh nu elvish xonsh "

# What a terminal may be running for a restore to start it again: programs
# that stay open and are safe to open twice — editors, viewers, monitors, git
# and file managers, remote shells, multiplexers. Anything else — a build, an
# upgrade, a deploy — is not run again, and the terminal comes back as a shell
# in its directory. AI agents are left off, since an argument to one can be a
# prompt it would act on a second time. `rerun` in the presets file, a list
# of program names, adds to this one.
PRESET_RERUN="nvim vim vi nano hx helix emacs micro kak
  btop htop top btm nvtop glances ncdu k9s
  lazygit lazydocker gitui tig yazi ranger lf nnn mc
  less more man ssh mosh tmux zellij screen herdr
  cmus ncmpcpp newsboat weechat irssi aerc neomutt calcurse"

rerun_allowed() { # program, by path or name
  local name=${1##*/} extra
  [[ -n $name ]] || return 1
  extra=$(presets_json 2>/dev/null | jq -r '.rerun // [] | map(tostring) | join(" ")' 2>/dev/null || true)
  [[ " ${PRESET_RERUN//$'\n'/ } $extra " == *" $name "* ]]
}

# A terminal comes back in the directory it was in, under the app id it had.
# What was running in it comes back too when it is on the rerun list; when it
# is not, only its name is kept, for `preset show` to say what was left out.
# Several windows sharing one terminal process — a foot server, a
# single-instance kitty — cannot be told apart from the outside, so those
# come back as a plain shell.
terminal_recipe() {
  local pid=$1 class=$2 shared=$3 child fg cwd="" run="[]" skipped=""
  if [[ $shared != true ]]; then
    child=$(pgrep -o -P "$pid" 2>/dev/null || true)
    if [[ -n $child ]]; then
      fg=$(foreground_of "$child")
      cwd=$(readlink "/proc/$fg/cwd" 2>/dev/null || true)
      if [[ $PRESET_SHELLS != *" $(cat "/proc/$fg/comm" 2>/dev/null) "* ]]; then
        run=$(proc_argv "$fg")
        if ! rerun_allowed "$(jq -r '.[0] // ""' <<<"$run")"; then
          skipped=$(jq -r 'join(" ")' <<<"$run")
          run="[]"
        fi
      fi
    fi
  fi
  jq -cn --arg c "$class" --arg d "$cwd" --argjson r "$run" --arg s "$skipped" '
    { via: "terminal" }
    + (if $d == "" then {} else { cwd: $d } end)
    + (if ($r | length) > 0 then { run: $r } else {} end)
    + (if $s == "" then {} else { skipped: $s } end)'
}

# Made at restore time, never taken from the file whole: the program is
# looked up on the rerun list again, so a preset from an older version, or
# edited by hand, cannot run anything the list does not allow. It runs in a
# shell that stays when it exits, as the terminal it was saved from would.
terminal_argv() { # class cwd run-json
  local run=${3:-[]}
  if ! jq -e 'type == "array" and all(.[]; type == "string")' <<<"$run" >/dev/null 2>&1 ||
    ! rerun_allowed "$(jq -r '.[0] // ""' <<<"$run")"; then
    run="[]"
  fi
  jq -cn --arg c "$1" --arg d "$2" --argjson r "$run" '
    ["uwsm-app", "--", "xdg-terminal-exec", "--app-id=" + $c]
    + (if $d == "" then [] else ["--dir=" + $d] end)
    + (if ($r | length) == 0 then []
       else ["-e", "bash", "-c", "\"$@\"; exec \"${SHELL:-bash}\"", "_"] + $r end)'
}

# A web app opened while its browser was already running is a window of the
# browser's process, whose command line knows nothing of it. Its class does:
# Chromium names it browser-host_path-profile, with the path's slashes as
# underscores, so chrome-claude.ai__-Default is https://claude.ai/.
webapp_url() {
  [[ $1 =~ ^(chrome|chromium|brave|msedge|vivaldi|opera|helium)-([^_]+)_(.*)-[^-]+$ ]] || return 0
  printf 'https://%s%s\n' "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]//_//}"
}

# A browser's own windows — not a web app of it.
browser_class() {
  [[ ${1,,} =~ ^(chromium|google-chrome.*|brave-browser.*|microsoft-edge.*|vivaldi.*|opera.*|helium.*)$ ]]
}

# Whether a URL is the one this window is a web app of. A browser runs every
# window from one process, whose command line keeps the --app= of whichever
# web app happened to start it — so that URL is taken only when the class
# names the same site and path, or the process is this window's alone and
# not the browser itself. The class drops what an underscore stood for; the
# URL keeps it, which is why it is worth having.
webapp_fits() { # url class shared
  local rest host path
  [[ $3 != true ]] || return 1
  if [[ -z $(webapp_url "$2") ]]; then
    ! browser_class "$2"
    return
  fi
  rest=${1#*://}
  rest=${rest%%[?#]*}
  host=${rest%%/*}
  path=/${rest#"$host"}
  path=${path#//}
  path=/${path#/}
  [[ $2 == *-"$host"_"${path//\//_}"-* ]]
}

application_dirs() {
  local dirs d
  printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
  IFS=: read -ra dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for d in "${dirs[@]}"; do
    if [[ -n $d ]]; then printf '%s\n' "$d/applications"; fi
  done
}

# The desktop entry that opens windows of this class: the one that says so
# with StartupWMClass, or else the one named after it. A desktop id keeps its
# subdirectories as dashes.
desktop_for() {
  local class=$1 dir file dirs=()
  mapfile -t dirs < <(application_dirs)
  for dir in "${dirs[@]}"; do
    [[ -d $dir ]] || continue
    file=$(grep -rlisFx --include='*.desktop' "StartupWMClass=$class" "$dir" | head -1 || true)
    if [[ -n $file ]]; then
      file=${file#"$dir"/}
      echo "${file//\//-}"
      return
    fi
  done
  for dir in "${dirs[@]}"; do
    for file in "$dir/$class.desktop" "$dir/${class,,}.desktop"; do
      if [[ -f $file ]]; then
        basename "$file"
        return
      fi
    done
  done
}

# How to open a window like this one again, first match wins: a terminal, a
# web app, the app's desktop entry, and last the command line its process was
# started with. The command line rides along with a desktop entry as the
# fallback, for the entry that has gone away since.
launch_recipe() {
  local w=$1 pid class argv url desktop
  pid=$(jq -r .pid <<<"$w")
  class=$(jq -r .class <<<"$w")
  if [[ $(jq -r .terminal <<<"$w") == true ]]; then
    terminal_recipe "$pid" "$class" "$(jq -r .shared <<<"$w")"
    return
  fi
  argv=$(proc_argv "$pid")
  url=$(jq -r 'map(select(startswith("--app="))) | first // "" | ltrimstr("--app=")' <<<"$argv")
  if [[ -n $url ]] && ! webapp_fits "$url" "$class" "$(jq -r .shared <<<"$w")"; then url=""; fi
  [[ -n $url ]] || url=$(webapp_url "$class")
  if [[ -n $url ]]; then
    jq -cn --arg u "$url" '{ via: "webapp", argv: ["omarchy-launch-webapp", $u] }'
    return
  fi
  desktop=$(desktop_for "$class")
  if [[ -n $desktop ]]; then
    jq -cn --arg d "$desktop" --argjson f "$argv" '
      { via: "desktop", argv: ["uwsm-app", "--", $d] }
      + (if ($f | length) > 0 then { fallback: (["uwsm-app", "--"] + $f) } else {} end)'
    return
  fi
  if [[ $argv != "[]" ]]; then
    jq -cn --argjson f "$argv" '{ via: "command", argv: (["uwsm-app", "--"] + $f) }'
    return
  fi
  echo '{"via":"none"}'
}

preset_save() {
  local name=$1 skip=$2 existing mons clients windows preset kept total missing
  jq -e 'type == "array"' <<<"$skip" >/dev/null 2>&1 || die "--skip takes a JSON array of window addresses"
  existing=$(presets_json)
  mons=$(monitors_json)
  clients=$(clients_json)
  windows=$(jq -c --argjson skip "$skip" --argjson mons "$mons" "$PRESET_SNAPSHOT_JQ" <<<"$clients")

  preset=$(jq -c '.[]' <<<"$windows" | while IFS= read -r w; do
    jq -c --argjson l "$(launch_recipe "$w")" '. + { launch: $l } | del(.pid, .stable, .shared, .terminal)' <<<"$w"
  done | jq -cs --argjson mons "$mons" --argjson spaces "$(workspaces_json)" '
    . as $windows
    | { saved: (now | todate),
        focused: ([ $mons[] | select(.focused) | .activeWorkspace.id ] | first // null),
        shown: ([ $mons[] | .activeWorkspace.id | select(. > 0) ] | unique),
        workspaces: ([ $spaces[]
          | select(.id as $id | $windows | any(.workspace == $id))
          | (.monitorID as $m | $mons | map(select(.id == $m)) | first) as $mon
          | { key: (.id | tostring),
              value: { layout: (.tiledLayout // "dwindle"),
                       monitor: (if $mon == null then null
                                 else (if (($mon.transform // 0) % 2) == 1 then [$mon.height, $mon.width]
                                       else [$mon.width, $mon.height] end)
                                      | if any(. == null) then null
                                        else map(. / ($mon.scale // 1) | round) end end) } } ]
          | from_entries),
        windows: $windows }')

  jq --arg n "$name" --argjson p "$preset" '.presets[$n] = $p' <<<"$existing" | write_presets

  kept=$(jq '.windows | length' <<<"$preset")
  total=$(jq '[.[] | select(.workspace.id > 0)] | length' <<<"$clients")
  local spaces; spaces=$(jq '.windows | map(.workspace) | unique | length' <<<"$preset")
  local summary="$kept window$( ((kept == 1)) || echo s) on $spaces workspace$( ((spaces == 1)) || echo s)"
  ((total > kept)) && summary+=" ($((total - kept)) left out)"
  say "Saved “$name”: $summary."
  missing=$(jq -r '.windows[] | select(.launch.via == "none") | .class' <<<"$preset")
  if [[ -n $missing ]]; then
    echo "omarchy-workspaces: no way found to reopen: $(tr '\n' ' ' <<<"$missing")" >&2
  fi
  notify "Saved “$name”" "$summary"
}

preset_list() {
  local out
  out=$(presets_json | jq -r '.presets | to_entries | sort_by(.key | ascii_downcase)[]
    | (.value.windows | length) as $w
    | (.value.windows | map(.workspace) | unique | length) as $s
    | "  \(.key) — \($w) window\(if $w == 1 then "" else "s" end) on \($s) workspace\(if $s == 1 then "" else "s" end)"
      + (if .value.saved then ", saved \(.value.saved[0:16] | sub("T"; " "))" else "" end)')
  if [[ -z $out ]]; then
    say "No presets yet. Save one from the overview (S), or with 'preset save <name>'."
  else
    echo "$out"
  fi
}

preset_show() {
  preset_get "$1" | jq -r '
    (.workspaces // {}) as $spaces
    | .windows | group_by(.workspace)[]
    | "  " + (.[0].workspace | tostring)
      + ($spaces[.[0].workspace | tostring].layout // "" | if . == "" then "" else "  (" + . + ")" end) + "\n"
      + (map("      " + .class
             + (if .floating then " (floating)" else "" end)
             + "  — " + .launch.via
             + (if .launch.cwd then " in " + .launch.cwd else "" end)
             + (if .launch.run then ": " + (.launch.run | join(" ")) else "" end)
             + (if .launch.skipped then "  (not run again: " + .launch.skipped + ")" else "" end))
         | join("\n"))'
}

preset_delete() {
  local existing
  preset_get "$1" >/dev/null
  existing=$(presets_json)
  jq --arg n "$1" 'del(.presets[$n])' <<<"$existing" | write_presets
  say "Deleted “$1”."
}

# ── restoring it ─────────────────────────────────────────────────────────────

# Which window already open stands in for which window of the preset. Only
# the same app qualifies. Two passes, so a window with the exact title is
# never taken by an earlier, vaguer match, and within a pass a window already
# on the right workspace is preferred. Special workspaces are out: moving the
# scratchpad's terminal onto the desk is not what restoring a desk means.
PRESET_PLAN_JQ='
  ($open | map(select(.workspace.id > 0))) as $open
  | def claim($exact):
      reduce range(0; $want | length) as $i (.;
        if .plan[$i] != null then . else
          . as $s | $want[$i] as $w
          | ([ $open[]
               | select(.class == $w.class)
               | select(.address as $a | $s.claimed | index($a) | not)
               | select(($exact | not) or .title == $w.title) ]
             | sort_by(if .workspace.id == $w.workspace then 0 else 1 end)
             | first) as $hit
          | if $hit == null then . else .plan[$i] = $hit.address | .claimed += [$hit.address] end
        end);
  { plan: [range(0; $want | length) | null], claimed: [] }
  | claim(true) | claim(false)
  | . as $s
  | [ range(0; $want | length) as $i | $want[$i] + { reuse: $s.plan[$i] } ]'

# The layout of one workspace, read back out of where its tiled windows sat,
# as the steps that build it again. The input is those windows as
# { i, x0, y0, x1, y1, fs }; each step tiles window `tile`, most of them next
# to window `onto`, which is in place already.
#
# Dwindle is a tree of splits, and every split in it runs the whole length of
# the space it divides. So the space is cut where a line runs through it
# without crossing a window — across before down — and each side is cut
# again. The first window of the second side is tiled onto the first window
# of the first, towards it (`dir`), and that split is then set to where the
# cut was (`ratio`: dwindle's, which is twice the first side's share).
#
# Scrolling is a row of columns, a column being the windows that start at the
# same x. The top one of each is tiled after the column before and sized
# (`width`, the column's share of the monitor, gaps and all); the ones under
# it are pulled into its column (`consume`).
#
# Any other layout, or a dwindle desk that does not cut cleanly, is tiled in
# order and left to the layout. So is a fullscreen window, whose size says
# nothing about its place.
PRESET_LAYOUT_JQ='
  def r3: . * 1000 | round / 1000;
  def cut($lo; $hi):
    sort_by(.[$lo]) as $s
    | first(range(1; $s | length) as $k
        | ($s[:$k] | map(.[$hi]) | max) as $edge
        | ($s[$k:] | map(.[$lo]) | min) as $next
        | select($next >= $edge - 8)
        | { a: $s[:$k], b: $s[$k:], at: (($edge + $next) / 2),
            lo: ($s | map(.[$lo]) | min), hi: ($s | map(.[$hi]) | max) }) // null;
  def split:
    (cut("x0"; "x1") | if . == null then null else . + { dir: "r" } end)
    // (cut("y0"; "y1") | if . == null then null else . + { dir: "d" } end);
  def first_leaf:
    if length == 1 then .[0].i
    else split as $c | if $c == null then .[0].i else $c.a | first_leaf end end;
  def build:
    if length <= 1 then []
    else split as $c
      | if $c == null then .[0].i as $anchor | [ .[1:][] | { tile: .i, onto: $anchor } ]
        else [ { tile: ($c.b | first_leaf), onto: ($c.a | first_leaf), dir: $c.dir,
                 ratio: ([1.9, ([0.1, 2 * ($c.at - $c.lo) / ($c.hi - $c.lo)] | max)] | min | r3) } ]
             + ($c.a | build) + ($c.b | build)
        end
    end;
  def columns:
    sort_by(.x0, .y0)
    | reduce .[] as $r ([];
        if length > 0 and (($r.x0 - .[-1][0].x0) | fabs) <= 8 then .[-1] += [$r] else . + [[$r]] end)
    | map(sort_by(.y0));
  map(select(.fs | not)) as $placed
  | map(select(.fs)) as $full
  | ($placed
     | if length == 0 then []
       elif $layout == "dwindle" then [ { tile: first_leaf } ] + build
       elif $layout == "scrolling" and $width > 0 then
         columns as $cols
         | [ range(0; $cols | length) as $k | $cols[$k] as $col
             | { tile: $col[0].i, onto: (if $k == 0 then null else $cols[$k - 1][0].i end),
                 width: (($col[0].x1 - $col[0].x0 + 2 * $gapsIn) / ($width - 2 * $gapsOut) | r3) },
               ($col[1:][] | { tile: .i, onto: $col[0].i, consume: true }) ]
       else sort_by(.y0, .x0) | map({ tile: .i })
       end)
  + ($full | map({ tile: .i }))'

# The first of a gap option's values, or the default where there is no
# Hyprland to ask.
hypr_number() { # option default
  local v
  v=$(hyprctl getoption "$1" -j 2>/dev/null |
    jq -r '.float // .int // ((.css // .custom // "") | split(" ")[0]) // empty' 2>/dev/null || true)
  if [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]]; then echo "$v"; else echo "$2"; fi
}

layout_steps() { # layout monitor-width windows-json
  jq -c --arg layout "$1" --argjson width "${2:-0}" \
    --argjson gapsIn "$(hypr_number general:gaps_in 5)" --argjson gapsOut "$(hypr_number general:gaps_out 20)" \
    "$PRESET_LAYOUT_JQ" <<<"$3"
}

# The layout a workspace tiles with now, which is the one to build for; the
# one it had when saved, where Hyprland cannot say.
layout_of() { # workspace saved
  local live
  live=$(workspaces_json | jq -r --argjson w "$1" '.[] | select(.id == $w) | .tiledLayout // empty' 2>/dev/null || true)
  echo "${live:-${2:-dwindle}}"
}

# A workspace's tiled windows as PRESET_LAYOUT_JQ takes them, named by
# whatever $ids gives for each index of the plan.
layout_windows() { # plan workspace ids-json
  jq -c --argjson w "$2" --argjson ids "$3" '
    [ to_entries[]
      | select(.value.workspace == $w and (.value.floating | not))
      | $ids[.key | tostring] as $i | select($i != null)
      | .value as $v
      | { i: $i, x0: $v.at[0], y0: $v.at[1], x1: ($v.at[0] + $v.size[0]), y1: ($v.at[1] + $v.size[1]),
          fs: (($v.fullscreen // 0) > 0) } ]' <<<"$1"
}

# Lua long brackets hold the pattern verbatim; only the regex needs escaping.
regex_quote() { sed 's/[][\\.*^$+?(){}|]/\\&/g' <<<"$1"; }

# Put the next window of this class straight onto its workspace, silently, so
# it never flashes up on the screen being looked at. It is the pattern
# omarchy-launch-about uses: one named rule, replaced before each launch and
# switched off after. Every window arrives floating — the floating ones where
# they belong, the tiled ones out of the way until their workspace is
# arranged, all at once, in the shape it was saved in.
PRESET_RULE="omarchy_workspaces_preset_rule"

preset_rule() {
  local w=$1 class ws effects
  class=$(jq -r .class <<<"$w")
  ws=$(jq -r .workspace <<<"$w")
  # A rule's move is relative to the monitor, which is how `at` is stored.
  effects=$(jq -r 'if .floating
    then "float = true, size = { \(.size[0]), \(.size[1]) }, move = { \(.at[0]), \(.at[1]) }"
    else "float = true" end' <<<"$w")
  hyprctl eval "if $PRESET_RULE then $PRESET_RULE:set_enabled(false) end; $PRESET_RULE = hl.window_rule({ match = { class = [==[^($(regex_quote "$class"))\$]==] }, workspace = \"$ws silent\", $effects })" >/dev/null 2>&1 || true
}

preset_rule_off() {
  hyprctl eval "if $PRESET_RULE then $PRESET_RULE:set_enabled(false) end; $PRESET_RULE = nil" >/dev/null 2>&1 || true
}

# A window of this class that nobody has claimed: one this restore opened.
# Everything that was open when it started is claimed from the outset, so
# nothing the user had open is ever mistaken for it.
fresh_window() {
  local a
  while IFS= read -r a; do
    if [[ -n $a && -z ${PRESET_TAKEN[$a]:-} ]]; then
      echo "$a"
      return
    fi
  done < <(clients_json | jq -r --arg c "$1" '.[] | select(.class == $c or .initialClass == $c) | .address')
}

await_window() {
  local deadline=$((SECONDS + LAUNCH_TIMEOUT)) a
  while ((SECONDS < deadline)); do
    a=$(fresh_window "$1")
    if [[ -n $a ]]; then
      echo "$a"
      return
    fi
    sleep 0.25
  done
}

launch_argv() { # json array of argv
  local argv=()
  mapfile -t argv < <(jq -r '.[]' <<<"$1")
  ((${#argv[@]})) || return 1
  # Not with the restore's lock: an app that kept it open would stop every
  # later restore for as long as the app runs.
  setsid -f "${argv[@]}" >/dev/null 2>&1 </dev/null 9>&-
}

# A path that is executable, or a name on PATH.
runnable() {
  if [[ $1 == */* ]]; then [[ -x $1 ]]; else command -v "$1" >/dev/null 2>&1; fi
}

# Whether a desktop id still names an entry. Its dashes may stand for
# subdirectories, as desktop_for writes them.
desktop_exists() {
  local id=$1 dir file
  while IFS= read -r dir; do
    if [[ -f $dir/$id ]]; then return 0; fi
    [[ -d $dir ]] || continue
    while IFS= read -r file; do
      file=${file#"$dir"/}
      if [[ ${file//\//-} == "$id" ]]; then return 0; fi
    done < <(find "$dir" -mindepth 2 -name '*.desktop' 2>/dev/null)
  done < <(application_dirs)
  return 1
}

# How to open this window of the preset now, as a JSON argv — or nothing when
# what opened it is gone: an app uninstalled since, or one of Omarchy's own
# terminal windows, which an older version saved and this one does not
# restore. A terminal's command is made here by terminal_argv, which checks
# the rerun list, and never taken from the file as it stands.
launch_now() {
  local w=$1 class
  class=$(jq -r .class <<<"$w")
  case $(jq -r '.launch.via // "none"' <<<"$w") in
    terminal)
      if [[ ! $class =~ ^(org\.omarchy\.|TUI\.) ]] && runnable xdg-terminal-exec; then
        terminal_argv "$class" "$(jq -r '.launch.cwd // ""' <<<"$w")" "$(jq -c '.launch.run // []' <<<"$w")"
      fi ;;
    webapp)
      # A preset saved before webapp_fits may have the URL of another web
      # app of the same browser: the class says which site it really was,
      # and a browser's own window was never a web app at all.
      local url saved
      saved=$(jq -r '.launch.argv[1] // ""' <<<"$w")
      url=$(webapp_url "$class")
      if browser_class "$class"; then
        url=$(desktop_for "$class")
        if [[ -n $url ]]; then jq -cn --arg d "$url" '["uwsm-app", "--", $d]'; fi
      elif runnable omarchy-launch-webapp; then
        if [[ -n $url ]] && ! webapp_fits "$saved" "$class" false; then saved=$url; fi
        jq -cn --arg u "$saved" '["omarchy-launch-webapp", $u]'
      fi ;;
    desktop)
      if desktop_exists "$(jq -r '.launch.argv[-1]' <<<"$w")"; then
        jq -c '.launch.argv' <<<"$w"
      elif runnable "$(jq -r '.launch.fallback[2] // ""' <<<"$w")"; then
        jq -c '.launch.fallback' <<<"$w"
      fi ;;
    command)
      if runnable "$(jq -r '.launch.argv[2] // ""' <<<"$w")"; then jq -c '.launch.argv' <<<"$w"; fi ;;
  esac
}

# What to call the app while restoring: the desktop entry's name, the web
# app's site, or else its class.
app_label() {
  local w=$1 name="" id dir
  case $(jq -r '.launch.via // ""' <<<"$w") in
    terminal) name=$(jq -r 'if .launch.run then "Terminal (\(.launch.run[0] | split("/")[-1]))" else "Terminal" end' <<<"$w") ;;
    webapp) name=$(jq -r '.launch.argv[-1] // "" | sub("^[a-z]+://"; "") | sub("/.*$"; "")' <<<"$w") ;;
    desktop)
      id=$(jq -r '.launch.argv[-1]' <<<"$w")
      while IFS= read -r dir; do
        if [[ -f $dir/$id ]]; then
          name=$(grep -m1 '^Name=' "$dir/$id" 2>/dev/null | cut -d= -f2- || true)
          break
        fi
      done < <(application_dirs) ;;
  esac
  if [[ -z $name ]]; then name=$(jq -r .class <<<"$w"); fi
  printf '%s\n' "$name"
}

# The float dispatcher only toggles, so it is sent only when the window is
# the other way.
set_floating() { # address true|false
  local now
  now=$(clients_json | jq -r --arg a "$1" '.[] | select(.address == $a) | .floating // false')
  if [[ -n $now && $now != "$2" ]]; then dispatch "hl.dsp.window.float({ window = \"address:$1\" })"; fi
}

workspace_origin() {
  local monitor
  monitor=$(workspaces_json | jq -r --argjson w "$1" '.[] | select(.id == $w) | .monitor')
  monitors_json | jq -r --arg m "$monitor" '
    (map(select(.name == $m)) | first) // (map(select(.focused)) | first) // { x: 0, y: 0 }
    | "\(.x) \(.y)"'
}

# Move a window onto its workspace. A floating one gets its size and place
# back now. A tiled one is floated for the moment, out of the layout, and
# tiled again when its workspace is arranged.
place() {
  local w=$1 a=$2 live ws floating pinned x y width height mx my
  live=$(clients_json | jq -c --arg a "$a" '.[] | select(.address == $a)')
  [[ -n $live ]] || return 0
  read -r ws floating pinned x y width height <<<"$(jq -r '
    "\(.workspace) \(.floating) \(.pinned // false) \(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"' <<<"$w")"

  if [[ $(jq -r .workspace.id <<<"$live") != "$ws" ]]; then
    dispatch "hl.dsp.window.move({ window = \"address:$a\", workspace = \"$ws\", follow = false })"
  fi
  if [[ $(jq -r '.fullscreen // 0' <<<"$live") != 0 ]]; then
    dispatch "hl.dsp.window.fullscreen({ window = \"address:$a\" })"
  fi
  set_floating "$a" true
  if [[ $floating == true ]]; then
    read -r mx my <<<"$(workspace_origin "$ws")"
    dispatch "hl.dsp.window.resize({ window = \"address:$a\", x = $width, y = $height })"
    dispatch "hl.dsp.window.move({ window = \"address:$a\", x = $((mx + x)), y = $((my + y)) })"
    if [[ $pinned == true && $(jq -r '.pinned // false' <<<"$live") != true ]]; then
      dispatch "hl.dsp.window.pin({ window = \"address:$a\" })"
    fi
  fi
}

# Tile a workspace's windows back into the layout they were saved in, one
# step of layout_steps at a time. They are all floating by now, so each one
# tiled goes in beside the window focused — the one the step names.
arrange() { # workspace steps-json
  local ws=$1 step tile onto dir ratio width consume base delta
  base=$(hypr_number dwindle:default_split_ratio 1)
  dispatch "hl.dsp.focus({ workspace = \"$ws\" })"
  while IFS= read -r step; do
    read -r tile onto dir ratio width consume <<<"$(jq -r '
      [.tile, (.onto // "-"), (.dir // "-"), (.ratio // "-"), (.width // "-"), (.consume // false)]
      | map(tostring) | join(" ")' <<<"$step")"
    if [[ $onto != - ]]; then dispatch "hl.dsp.focus({ window = \"address:$onto\" })"; fi
    if [[ $dir != - ]]; then dispatch "hl.dsp.layout(\"preselect $dir\")"; fi
    set_floating "$tile" false
    # A new split starts at dwindle's default ratio; splitratio only moves it.
    if [[ $ratio != - ]]; then
      delta=$(awk -v r="$ratio" -v b="$base" 'BEGIN { d = r - b; if (d > 0.001 || d < -0.001) printf "%.3f", d }')
      if [[ -n $delta ]]; then
        dispatch "hl.dsp.focus({ window = \"address:$tile\" })"
        dispatch "hl.dsp.layout(\"splitratio $delta\")"
      fi
    fi
    if [[ $width != - ]]; then
      dispatch "hl.dsp.focus({ window = \"address:$tile\" })"
      dispatch "hl.dsp.layout(\"colresize $width\")"
    fi
    if [[ $consume == true ]]; then
      dispatch "hl.dsp.focus({ window = \"address:$onto\" })"
      dispatch 'hl.dsp.layout("consume")'
    fi
  done < <(jq -c '.[]' <<<"$2")
}

# "a, b and c"
join_names() {
  local out=$1
  shift
  while (($#)); do
    if (($# == 1)); then out+=" and $1"; else out+=", $1"; fi
    shift
  done
  printf '%s' "$out"
}

preset_restore() {
  local name=$1 dry=$2 preset plan
  preset=$(preset_get "$name")
  plan=$(jq -cn --argjson want "$(jq -c .windows <<<"$preset")" --argjson open "$(clients_json)" "$PRESET_PLAN_JQ")
  # What opens each window that is not open already — null for what is gone.
  plan=$(jq -c '.[]' <<<"$plan" | while IFS= read -r w; do
    if [[ $(jq -r '.reuse // ""' <<<"$w") != "" ]]; then
      echo "$w"
    else
      jq -c --argjson now "$(launch_now "$w" | grep . || echo null)" '. + { now: $now }' <<<"$w"
    fi
  done | jq -cs .)

  if ((dry)); then
    jq -r '.[] | if .reuse then "reuse  \(.reuse) \(.class) → \(.workspace)"
      elif .now == null then "gone   \(.class) → \(.workspace): not installed, would be removed from the preset"
      else "launch \(.class) → \(.workspace): \(.now | join(" "))" end' <<<"$plan"
    local ws ids
    ids=$(jq -c '[to_entries[] | select(.value.reuse != null or .value.now != null)
                  | { key: (.key | tostring), value: "\(.value.class)#\(.key)" }] | from_entries' <<<"$plan")
    for ws in $(jq -r '[.[] | select(.floating | not) | .workspace] | unique | .[]' <<<"$plan"); do
      echo "arrange $ws ($(layout_of "$ws" "$(jq -r --arg w "$ws" '.workspaces[$w].layout // ""' <<<"$preset")"))"
      layout_steps "$(layout_of "$ws" "$(jq -r --arg w "$ws" '.workspaces[$w].layout // ""' <<<"$preset")")" \
        "$(jq -r --arg w "$ws" '.workspaces[$w].monitor[0] // 0' <<<"$preset")" \
        "$(layout_windows "$plan" "$ws" "$ids")" | jq -r '.[]
        | "  " + .tile
          + (if .dir then (if .dir == "r" then " right of " else " below " end) + .onto + ", ratio \(.ratio)"
             elif .consume then " under " + .onto
             elif .width then (if .onto then " after " + .onto else " first" end) + ", width \(.width)"
             elif .onto then " next to " + .onto
             else "" end)'
    done
    return 0
  fi

  # One restore at a time: a second click would launch everything twice.
  mkdir -p "$STATE_DIR"
  exec 9>"$STATE_DIR/preset-restore.lock"
  flock -n 9 || die "a preset is already being restored"
  local log="$STATE_DIR/preset-restore.log"
  printf '%s restoring “%s”\n' "$(date '+%F %T')" "$name" >"$log"

  declare -gA PRESET_TAKEN=()
  local a
  while IFS= read -r a; do
    if [[ -n $a ]]; then PRESET_TAKEN[$a]=1; fi
  done < <(clients_json | jq -r '.[].address')

  local total headline="Restoring “$name”"
  total=$(jq length <<<"$plan")
  progress "$headline" "Opening $total window$( ((total == 1)) || echo s)…"

  local w class ws label idx=-1 reused=0 opened=0 failed=() gone=() gone_at=()
  local -A placed=()
  while IFS= read -r w; do
    idx=$((idx + 1))
    class=$(jq -r .class <<<"$w")
    ws=$(jq -r .workspace <<<"$w")
    label=$(app_label "$w")
    a=$(jq -r '.reuse // ""' <<<"$w")
    if [[ -n $a ]]; then
      place "$w" "$a"
      placed[$idx]=$a
      reused=$((reused + 1))
      echo "reused $class → $ws" >>"$log"
      continue
    fi
    if [[ $(jq -r '.now == null' <<<"$w") == true ]]; then
      gone+=("$label")
      gone_at+=("$idx")
      echo "removed $class → $ws: it is not installed any more" >>"$log"
      continue
    fi

    progress "$headline" "Opening $label on workspace $ws  ·  $((idx + 1)) of $total"
    # A browser that restores its own session opens several windows for one
    # launch; the ones this preset is still waiting for are already here.
    a=$(fresh_window "$class")
    if [[ -z $a ]]; then
      preset_rule "$w"
      if launch_argv "$(jq -c .now <<<"$w")"; then a=$(await_window "$class"); fi
      if [[ -z $a ]] && [[ $(jq -r '.launch.via' <<<"$w") == desktop ]] &&
        runnable "$(jq -r '.launch.fallback[2] // ""' <<<"$w")" &&
        [[ $(jq -c '.now == .launch.fallback' <<<"$w") == false ]]; then
        echo "  $class did not open from its desktop entry; trying its command line" >>"$log"
        if launch_argv "$(jq -c '.launch.fallback' <<<"$w")"; then a=$(await_window "$class"); fi
      fi
      preset_rule_off
    fi

    if [[ -n $a ]]; then
      PRESET_TAKEN[$a]=1
      place "$w" "$a"
      placed[$idx]=$a
      opened=$((opened + 1))
      echo "opened $class → $ws" >>"$log"
    else
      failed+=("$label")
      echo "FAILED $class → $ws" >>"$log"
    fi
  done < <(jq -c '.[]' <<<"$plan")

  # Everything is on its workspace now; tile each one back into its layout.
  local ids="{}" k layout
  if ((${#placed[@]})); then
    ids=$(for k in "${!placed[@]}"; do printf '%s\t%s\n' "$k" "${placed[$k]}"; done |
      jq -Rn '[inputs | split("\t") | { key: .[0], value: .[1] }] | from_entries')
  fi
  for ws in $(jq -r '[.[] | select(.floating | not) | .workspace] | unique | .[]' <<<"$plan"); do
    layout=$(layout_of "$ws" "$(jq -r --arg w "$ws" '.workspaces[$w].layout // ""' <<<"$preset")")
    progress "$headline" "Arranging workspace $ws"
    arrange "$ws" "$(layout_steps "$layout" \
      "$(jq -r --arg w "$ws" '.workspaces[$w].monitor[0] // 0' <<<"$preset")" \
      "$(layout_windows "$plan" "$ws" "$ids")")"
    echo "arranged $ws ($layout)" >>"$log"
  done

  # Fullscreen last: a fullscreen window in the middle of the arranging would
  # have been in the way of every window tiled after it.
  for k in "${!placed[@]}"; do
    if [[ $(jq -r --argjson k "$k" '.[$k].fullscreen // 0' <<<"$plan") != 0 ]]; then
      local mode=fullscreen
      if [[ $(jq -r --argjson k "$k" '.[$k].fullscreen' <<<"$plan") == 1 ]]; then mode=maximized; fi
      dispatch "hl.dsp.window.fullscreen({ window = \"address:${placed[$k]}\", mode = \"$mode\", action = \"set\" })"
    fi
  done

  # Show what was on screen when it was saved, ending on the workspace that
  # had focus. Each workspace lives on its own monitor, so focusing one shows
  # it there.
  local focused
  focused=$(jq -r '.focused // empty' <<<"$preset")
  while IFS= read -r ws; do
    if [[ -n $ws && $ws != "$focused" ]]; then dispatch "hl.dsp.focus({ workspace = \"$ws\" })"; fi
  done < <(jq -r '.shown // [] | .[]' <<<"$preset")
  if [[ -n $focused ]]; then dispatch "hl.dsp.focus({ workspace = \"$focused\" })"; fi

  # An app that is gone will not come back, so the preset stops asking for
  # it. One that is there but did not open in time stays: next time it may.
  if ((${#gone_at[@]})); then
    presets_json | jq --arg n "$name" --argjson gone "$(printf '%s\n' "${gone_at[@]}" | jq -s .)" '
      .presets[$n].windows |= [ to_entries[] | select(.key as $k | $gone | index($k) | not) | .value ]' |
      write_presets
  fi

  local summary="$opened opened, $reused already open"
  if ((${#gone[@]})); then
    summary+=". Removed from the preset, as not installed any more: $(join_names "${gone[@]}")"
  fi
  if ((${#failed[@]})); then
    say "Restored “$name” ($summary). Did not open: $(join_names "${failed[@]}")"
    notify -u normal "Restored “$name”" "$summary. Did not open: $(join_names "${failed[@]}")"
    return 1
  fi
  say "Restored “$name” ($summary)."
  notify "Restored “$name”" "$summary."
}

cmd_preset() {
  local sub=${1:-list}
  (($#)) && shift
  local name="" skip="[]" dry=0
  while (($#)); do
    case $1 in
      --name)    name=${2?--name needs a value}; shift 2 ;;
      --skip)    skip=${2?--skip needs a value}; shift 2 ;;
      --dry-run) dry=1; shift ;;
      --notify)  NOTIFY=1; shift ;;
      --)        shift; name="$*"; break ;;
      -*)        die "preset $sub: unknown option $1" ;;
      *)         name="${name:+$name }$1"; shift ;;
    esac
  done

  case $sub in
    list) preset_list; return ;;
    save | show | restore | delete) ;;
    *) die "preset: unknown command '$sub' (save, list, show, restore, delete)" ;;
  esac
  name=$(preset_name "$name")
  case $sub in
    save)    preset_save "$name" "$skip" ;;
    show)    preset_show "$name" ;;
    restore) preset_restore "$name" "$dry" ;;
    delete)  preset_delete "$name" ;;
  esac
}

usage() {
  cat <<'USAGE'
omarchy-workspaces — pin Hyprland workspaces to specific monitors

  open                             Open the visual editor overlay
  overview                         Show every workspace full screen, or hide it
  bind-overview [--force]          Bind the overview to SUPER + the key left of 1
  overview-key                     Print the overview's shortcut as your keyboard labels it
  bootstrap                        Seed config + rules if missing, sync if not
  detect [--force] [--count=N]     Build a config from the connected monitors
  list                             Show the layout
  status                           Show where each workspace lives right now
  doctor                           Check the live state against the config
  assign <mon> <ws>                Assign workspaces (1-4, 1,2,5) to a monitor
  disable <ws>                     Switch workspaces off: no rule, no keybinding
  enable <ws>                      Switch them back on
  generate                         Write ~/.config/hypr/workspaces.lua
  apply                            Generate, reload Hyprland, re-home workspaces
  edit                             Open the config in your editor
  set-layout --base64 <b64>        Replace the layout (used by the overlay)

  preset save <name>               Save the open apps and where they sit
  preset list                      List the saved presets
  preset show <name>               Show what a preset would restore
  preset restore <name> [--dry-run]  Reopen its apps on their workspaces
  preset delete <name>             Delete a preset

Config: ~/.config/omarchy/workspaces.json
Plugin: ~/.config/omarchy/plugins/io.github.kimm-stensborg.workspaces
USAGE
}

main() {
  local args=()
  for a in "$@"; do
    case $a in
      --quiet) QUIET=1 ;;
      --force) FORCE=1 ;;
      --count=*) COUNT=${a#*=} ;;
      *) args+=("$a") ;;
    esac
  done
  set -- "${args[@]+"${args[@]}"}"
  case ${1:-status} in
    bootstrap) cmd_bootstrap ;;
    detect)   shift; cmd_detect "$@" ;;
    list)     cmd_list ;;
    status)   cmd_status ;;
    doctor)   cmd_doctor ;;
    assign|set) shift; cmd_assign "$@" ;;
    disable)  shift; cmd_workspace_state true "$@" ;;
    enable)   shift; cmd_workspace_state false "$@" ;;
    generate) cmd_generate ;;
    apply)    cmd_apply ;;
    edit)     cmd_edit ;;
    open)     cmd_open ;;
    overview) cmd_overview ;;
    overview-key) cmd_overview_key ;;
    bind-overview)
      cmd_bind_overview ||
        say "Nothing to bind: it is bound already, its key is taken, or it was removed (--force brings it back)." ;;
    set-layout) shift; cmd_set_layout "$@" ;;
    preset)   shift; cmd_preset "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
